---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate } from '@/lib/format';

interface Props {
  evento: CollectionEntry<'eventos'>;
  past?: boolean;
}

const { evento, past = false } = Astro.props;
const { data, slug } = evento;
const dateLabel = formatEventDate(data.date, data.endDate);
---

<article class:list={['event-card', { 'event-card--past': past }]}>
  <a class="event-card__link" href={`/eventos/${slug}/`} aria-label={data.title}>
    <div class="event-card__media">
      {
        data.flyer ? (
          <img
            src={data.flyer}
            alt={data.flyerAlt ?? `Flyer del evento: ${data.title}`}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="event-card__placeholder" aria-hidden="true">
            <span class="therefore">∴</span>
          </div>
        )
      }
      <span class:list={['event-card__type', `event-card__type--${data.type}`]}>{data.type}</span>
    </div>
    <div class="event-card__body">
      <p class="event-card__date">{dateLabel}</p>
      <h3 class="event-card__title">{data.title}</h3>
      <p class="event-card__location">{data.location}</p>
      {data.excerpt && <p class="event-card__excerpt">{data.excerpt}</p>}
    </div>
  </a>
</article>

<style>
  .event-card {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .event-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), var(--shadow-gold);
    border-color: rgba(201 168 76 / 0.55);
  }
  .event-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .event-card__link:hover {
    text-decoration: none;
    opacity: 1;
  }
  .event-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--md-sys-color-surface-container-high);
    overflow: hidden;
  }
  .event-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--obsidian);
    transition: transform 0.4s ease;
  }
  .event-card:hover .event-card__media img {
    transform: scale(1.02);
  }
  .event-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 4rem;
    color: var(--gold);
    opacity: 0.4;
    background: linear-gradient(
      135deg,
      var(--md-sys-color-surface-container-high),
      var(--md-sys-color-surface-container-highest)
    );
  }
  .event-card__type {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--gold);
    color: var(--obsidian);
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .event-card__body {
    padding: 1rem 1.25rem 1.25rem;
  }
  .event-card__date {
    font-size: 0.75rem;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-display);
    margin: 0 0 0.4rem;
  }
  .event-card__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    margin: 0 0 0.4rem;
    color: var(--md-sys-color-on-surface);
  }
  .event-card__location {
    font-size: 0.9rem;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 0.5rem;
  }
  .event-card__excerpt {
    font-size: 0.9rem;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .event-card--past {
    opacity: 0.6;
  }
  .event-card--past:hover {
    opacity: 0.85;
  }
</style>
