---
import { getCollection } from 'astro:content';
import PublicLayout from '@layouts/PublicLayout.astro';
import AtmosphericBanner from '@components/AtmosphericBanner.astro';

const all = (await getCollection('cuadro')).sort((a, b) => b.data.anio - a.data.anio);
const requestedYear = Astro.url.searchParams.get('año') ?? Astro.url.searchParams.get('year');
const selected =
  (requestedYear && all.find((e) => String(e.data.anio) === requestedYear)) ?? all[0];

type Cargo = { cargo: string; nombre: string; grado?: string };

const dignatarios: Cargo[] = selected
  ? [
      { cargo: 'Venerable Maestro', ...selected.data.venerableMaestro },
      ...(selected.data.primerVigilante
        ? [{ cargo: 'Primer Vigilante', ...selected.data.primerVigilante }]
        : []),
      ...(selected.data.segundoVigilante
        ? [{ cargo: 'Segundo Vigilante', ...selected.data.segundoVigilante }]
        : []),
      ...(selected.data.orador ? [{ cargo: 'Orador', ...selected.data.orador }] : []),
      ...(selected.data.secretario ? [{ cargo: 'Secretario', ...selected.data.secretario }] : []),
      ...(selected.data.tesorero ? [{ cargo: 'Tesorero', ...selected.data.tesorero }] : []),
    ]
  : [];

// Todos los dignatarios y oficiales son maestros; se combinan con los maestros
// adicionales (sin cargo) listados en el JSON, evitando duplicados.
const maestros = selected
  ? [
      ...new Set([
        ...dignatarios.map((d) => d.nombre),
        ...selected.data.oficiales.map((o) => o.nombre),
        ...selected.data.maestros,
      ]),
    ]
  : [];

const columnas = selected
  ? [
      {
        titulo: 'Maestros',
        simbolo: '∴',
        descripcion:
          'Constituyen la plenitud de los derechos masónicos. Aplican y transmiten el conocimiento, asumen responsabilidades de liderazgo y pueden ocupar cargos de oficialidad.',
        piedra: 'La piedra perfectamente trabajada.',
        miembros: maestros,
      },
      {
        titulo: 'Compañeros',
        simbolo: '∷',
        descripcion:
          'Segunda etapa del desarrollo simbólico. Profundizan en las artes, ciencias y filosofía, ampliando su visión y participando de manera más activa en los trabajos.',
        piedra: 'La piedra cúbica o desbastada.',
        miembros: selected.data.companeros,
      },
      {
        titulo: 'Aprendices',
        simbolo: '·',
        descripcion:
          'Primera etapa de formación. Aprenden los principios fundamentales de la Orden y trabajan en su perfeccionamiento moral e intelectual mediante la disciplina y el estudio.',
        piedra: 'La piedra bruta.',
        miembros: selected.data.aprendices,
      },
    ].filter((c) => c.miembros.length > 0)
  : [];

const pastMasters = (await getCollection('pastmasters'))
  .flatMap((entry) => entry.data.items)
  .sort((a, b) => b.anio - a.anio);
---

<PublicLayout
  title="Cuadro Logial"
  description="Cuadro de Dignatarios, Oficiales y miembros activos de la R∴L∴S∴ Masada No. 324."
>
  <AtmosphericBanner
    title="Cuadro Logial"
    subtitle={selected ? `Periodo masónico ${selected.data.anioVulgar}` : undefined}
    height="sm"
  />

  <section class="section">
    <div class="container">
      {
        all.length > 1 && (
          <nav class="years" aria-label="Seleccionar año">
            {all.map((entry) => (
              <a
                href={`/cuadro-logial/?año=${entry.data.anio}`}
                class:list={['years__item', { 'is-active': entry.id === selected?.id }]}
              >
                {entry.data.anioVulgar}
              </a>
            ))}
          </nav>
        )
      }

      {
        !selected ? (
          <div class="empty">
            <p>El cuadro logial está siendo actualizado. Vuelve pronto.</p>
          </div>
        ) : (
          <>
            <h2 class="text-center">Dignatarios</h2>
            <div class="grid-3 dignatarios">
              {dignatarios.map((d) => (
                <article class="role-card">
                  <p class="role-card__role">{d.cargo}</p>
                  <p class="role-card__name">
                    {d.grado && <span class="role-card__grade">{d.grado}</span>}
                    {d.nombre}
                  </p>
                </article>
              ))}
            </div>

            {selected.data.oficiales.length > 0 && (
              <>
                <h2 class="text-center oficiales-title">Oficiales</h2>
                <div class="grid-3 dignatarios">
                  {selected.data.oficiales.map((d) => (
                    <article class="role-card role-card--secondary">
                      <p class="role-card__role">{d.cargo}</p>
                      <p class="role-card__name">
                        {d.grado && <span class="role-card__grade">{d.grado}</span>}
                        {d.nombre}
                      </p>
                    </article>
                  ))}
                </div>
              </>
            )}

            {columnas.length > 0 && (
              <>
                <h2 class="text-center cuadro-title">Cuadro de miembros</h2>
                <div class="columnas">
                  {columnas.map((col) => (
                    <section class="columna">
                      <header class="columna__head">
                        <span class="columna__symbol" aria-hidden="true">
                          {col.simbolo}
                        </span>
                        <h3 class="columna__title">{col.titulo}</h3>
                        <button
                          class="columna__info"
                          type="button"
                          aria-expanded="false"
                          aria-label={`Acerca de los ${col.titulo}`}
                        >
                          <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 11v5" />
                            <path d="M12 8h.01" />
                          </svg>
                        </button>
                        <span class="columna__count">{col.miembros.length}</span>
                      </header>
                      <div class="columna__tip" hidden>
                        <p class="columna__desc">{col.descripcion}</p>
                        <p class="columna__stone">
                          <span class="columna__stone-label">Símbolo de trabajo</span>
                          {col.piedra}
                        </p>
                      </div>
                      <ul class="columna__list">
                        {col.miembros.map((nombre) => (
                          <li>{nombre}</li>
                        ))}
                      </ul>
                    </section>
                  ))}
                </div>
              </>
            )}
          </>
        )
      }

      {
        pastMasters.length > 0 && (
          <div class="past-masters">
            <h2 class="text-center cuadro-title">Past Masters</h2>
            <p class="text-center past-masters__lead">
              Maestros masones que han ocupado y concluido el cargo de Venerable Maestro.
              Aportan experiencia, continuidad institucional y conservan la memoria del taller.
            </p>
            <ol class="past-masters__list">
              {pastMasters.map((pm) => (
                <li class:list={['past-master', { 'past-master--current': pm.vigente }]}>
                  <span class="past-master__year">{pm.anio}</span>
                  <span class="past-master__name">{pm.nombre}</span>
                  {pm.vigente && <span class="past-master__badge">Vigente</span>}
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>
  </section>
</PublicLayout>

<style>
  .years {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    justify-content: center;
  }
  .years__item {
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--gold-border);
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    background: var(--md-sys-color-surface-container);
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .years__item:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .years__item.is-active {
    background: var(--gold);
    color: var(--obsidian);
    border-color: var(--gold);
  }
  .dignatarios {
    margin-bottom: 3rem;
  }
  .oficiales-title {
    margin-top: 2rem;
  }
  .role-card {
    text-align: center;
    padding: 1.75rem 1.25rem;
    background: var(--gold-muted);
    color: var(--md-sys-color-on-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--gold-border);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .role-card:hover {
    border-color: rgba(201 168 76 / 0.6);
    box-shadow: var(--shadow-gold);
  }
  .role-card--secondary {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--gold-border);
    opacity: 0.85;
  }
  .role-card--secondary:hover {
    opacity: 1;
  }
  .role-card__role {
    font-family: var(--font-display);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0 0 0.5rem;
    color: var(--gold);
  }
  [data-theme="light"] .role-card__role {
    color: var(--gold-dark);
  }
  .role-card__name {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.04em;
    margin: 0;
    line-height: 1.4;
  }
  .role-card__grade {
    display: block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    opacity: 0.6;
    margin-bottom: 0.2rem;
  }
  .empty {
    padding: 3rem;
    text-align: center;
    color: var(--md-sys-color-on-surface-variant);
    border: 1px dashed var(--gold-border);
    border-radius: var(--radius-md);
  }

  .cuadro-title {
    margin-top: 3.5rem;
  }

  /* ── Columnas de miembros ── */
  .columnas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 720px) {
    .columnas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .columna {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .columna__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.85rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--gold-border);
  }
  .columna__symbol {
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1;
  }
  [data-theme="light"] .columna__symbol {
    color: var(--gold-dark);
  }
  .columna__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .columna__info {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--gold);
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  [data-theme="light"] .columna__info {
    color: var(--gold-dark);
  }
  .columna__info:hover,
  .columna__info:focus-visible,
  .columna__info[aria-expanded='true'] {
    opacity: 1;
  }
  .columna__count {
    margin-left: auto;
    font-family: var(--font-label);
    font-size: 0.72rem;
    color: var(--md-sys-color-on-surface-variant);
    border: 1px solid var(--gold-border);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }
  .columna__tip {
    margin-bottom: 1.25rem;
    padding: 0.9rem 1rem;
    background: var(--gold-muted);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius-sm);
  }
  .columna__tip[hidden] {
    display: none;
  }
  .columna__desc {
    margin: 0 0 0.75rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--md-sys-color-on-surface-variant);
  }
  .columna__stone {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    color: var(--md-sys-color-on-surface);
  }
  .columna__stone-label {
    display: block;
    font-family: var(--font-label);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gold);
    margin-bottom: 0.25rem;
  }
  [data-theme="light"] .columna__stone-label {
    color: var(--gold-dark);
  }
  .columna__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .columna__list li {
    font-family: var(--font-display);
    font-size: 0.98rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
    color: var(--md-sys-color-on-surface);
    padding-left: 1rem;
    position: relative;
  }
  .columna__list li::before {
    content: '◆';
    position: absolute;
    left: 0;
    top: 0.15em;
    font-size: 0.5rem;
    color: var(--gold);
    opacity: 0.7;
  }
  [data-theme="light"] .columna__list li::before {
    color: var(--gold-dark);
  }

  /* ── Past Masters ── */
  .past-masters {
    margin-top: 1rem;
  }
  .past-masters__lead {
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 auto 2rem;
    max-width: 50ch;
  }
  .past-masters__list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 640px;
    display: grid;
    gap: 0.5rem;
  }
  .past-master {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius-md);
    transition: border-color 0.2s ease;
  }
  .past-master:hover {
    border-color: rgba(201 168 76 / 0.55);
  }
  .past-master__year {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--gold);
    min-width: 3.5rem;
  }
  [data-theme="light"] .past-master__year {
    color: var(--gold-dark);
  }
  .past-master__name {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.02em;
  }
  .past-master__badge {
    margin-left: auto;
    font-family: var(--font-label);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--obsidian);
    background: var(--gold);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }
  .past-master--current {
    background: var(--gold-muted);
    border-color: rgba(201 168 76 / 0.5);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.columna__info').forEach((btn) => {
    const tip = btn.closest('.columna')?.querySelector<HTMLElement>('.columna__tip');
    if (!tip) return;
    btn.addEventListener('click', () => {
      const willOpen = tip.hasAttribute('hidden');
      tip.toggleAttribute('hidden', !willOpen);
      btn.setAttribute('aria-expanded', String(willOpen));
    });
  });
</script>
