---
import { getEntry } from 'astro:content';
import PublicLayout from '@layouts/PublicLayout.astro';
import AtmosphericBanner from '@components/AtmosphericBanner.astro';

const catalog = await getEntry('books', 'catalog');
const items = catalog?.data.items ?? [];
---

<PublicLayout
  title="Biblioteca"
  description="Conocimiento libre. Catálogo de libros electrónicos disponibles para descarga (PDF, EPUB, Kindle)."
>
  <AtmosphericBanner title="Biblioteca" height="sm" />

  <section class="section">
    <div class="container container--narrow">
      <h2 class="text-center">¿Qué es el conocimiento libre?</h2>
      <blockquote>
        <p>
          «Si tú tienes una manzana y yo tengo una manzana e intercambiamos las manzanas, entonces
          tanto tú como yo seguiremos teniendo una manzana. Pero si tú tienes una idea y yo tengo
          una idea e intercambiamos ideas, entonces ambos tendremos dos ideas».
        </p>
        <footer>— George Bernard Shaw (1856–1950)</footer>
      </blockquote>
      <p class="text-justify">
        El conocimiento, a diferencia de la información, es una capacidad humana, la cual se vale
        de la información para resolver problemas y generar ideas. El conocimiento no puede ser
        considerado un objeto, ni un contenido, y sobre todo, no puede ni debe ser apropiado como
        si fuese un bien material.
      </p>
      <p class="text-justify">
        El conocimiento y el aprendizaje están claramente relacionados. El aprendizaje requiere del
        insumo llamado conocimiento, y este, a su vez, es producto del aprendizaje. Por ello, en
        esencia, para no romper el ciclo aprendizaje-conocimiento, es nuestro deber ser defensores
        de su dispersión y poner todo nuestro esfuerzo en compartirlo.
      </p>
      <p class="text-justify">
        Uno de los deberes del hombre para con su sociedad debe ser, en buena medida, comprender
        que el proceso de aprendizaje ocurre no sólo como práctica individual, sino también
        colectiva, y ambas se consolidan mutuamente. <em>Ergo</em>, es a través del intercambio y
        las comunicaciones interpersonales que se puede cultivar el conocimiento.
      </p>
    </div>
  </section>

  <AtmosphericBanner height="sm">
    <div class="hero">
      <h2 class="hero__title">Descarga de información</h2>
      <p class="hero__subtitle">
        Los libros listados representan el deseo de los miembros de Masada de ser elementos
        proactivos en la difusión del conocimiento.
      </p>
    </div>
  </AtmosphericBanner>

  <section class="section">
    <div class="container">
      {
        items.length > 0 ? (
          <>
            <div class="books-toolbar">
              <label class="books-search">
                <span class="sr-only">Buscar en la biblioteca</span>
                <input
                  id="books-search"
                  type="search"
                  placeholder="Buscar por título o autor…"
                  autocomplete="off"
                />
              </label>
              <p class="books-count" id="books-count">{items.length} títulos</p>
            </div>
            <div class="books-table-wrap">
              <table class="books-table" id="books-table">
                <thead>
                  <tr>
                    <th scope="col">Título</th>
                    <th scope="col">Autor</th>
                    <th scope="col" class="ta-center">PDF</th>
                    <th scope="col" class="ta-center">EPUB</th>
                    <th scope="col" class="ta-center">Kindle</th>
                  </tr>
                </thead>
                <tbody>
                  {items.map((b) => (
                    <tr data-search={`${b.title} ${b.author}`.toLowerCase()}>
                      <td><strong>{b.title}</strong></td>
                      <td>{b.author}</td>
                      <td class="ta-center">
                        {b.files.pdf ? (
                          <a href={b.files.pdf} download aria-label={`Descargar PDF de ${b.title}`}>
                            ↓
                          </a>
                        ) : (
                          <span aria-hidden="true">—</span>
                        )}
                      </td>
                      <td class="ta-center">
                        {b.files.epub ? (
                          <a href={b.files.epub} download aria-label={`Descargar EPUB de ${b.title}`}>
                            ↓
                          </a>
                        ) : (
                          <span aria-hidden="true">—</span>
                        )}
                      </td>
                      <td class="ta-center">
                        {b.files.kindle ? (
                          <a href={b.files.kindle} download aria-label={`Descargar Kindle de ${b.title}`}>
                            ↓
                          </a>
                        ) : (
                          <span aria-hidden="true">—</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ) : (
          <div class="empty">
            <p>El catálogo está siendo actualizado. Vuelve pronto.</p>
          </div>
        )
      }
    </div>
  </section>
</PublicLayout>

<style>
  .hero {
    text-align: center;
  }
  .hero__title {
    font-family: var(--font-display);
    margin: 0 0 0.5em;
    font-size: clamp(1.6rem, 3vw + 1rem, 2.5rem);
    color: var(--gold-light);
    letter-spacing: 0.08em;
    text-shadow: 0 2px 16px rgb(0 0 0 / 0.5);
  }
  .hero__subtitle {
    max-width: 60ch;
    margin: 0 auto;
    color: rgba(255 255 255 / 0.8);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.4);
  }
  .books-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .books-search input {
    width: min(100%, 360px);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--gold-border);
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    font-size: 0.95rem;
    transition: border-color 0.15s ease;
  }
  .books-search input:focus {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
    border-color: var(--gold);
  }
  .books-count {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.85rem;
    font-family: var(--font-display);
    letter-spacing: 0.06em;
  }
  .books-table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--gold-border);
  }
  .books-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .books-table th,
  .books-table td {
    padding: 0.9rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--gold-border);
  }
  .books-table th {
    background: var(--md-sys-color-surface-container-high);
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 400;
  }
  [data-theme="light"] .books-table th {
    color: var(--gold-dark);
  }
  .books-table tbody tr:last-child td {
    border-bottom: none;
  }
  .books-table tbody tr:hover {
    background: var(--gold-muted);
  }
  .ta-center {
    text-align: center;
  }
  .books-table a {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--gold);
    color: var(--obsidian);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    transition: background 0.15s ease;
  }
  .books-table a:hover {
    background: var(--gold-light);
    color: var(--obsidian);
    opacity: 1;
  }
  .empty {
    padding: 3rem;
    text-align: center;
    color: var(--md-sys-color-on-surface-variant);
    border: 1px dashed var(--gold-border);
    border-radius: var(--radius-md);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<script>
  const input = document.getElementById('books-search') as HTMLInputElement | null;
  const table = document.getElementById('books-table');
  const count = document.getElementById('books-count');
  if (input && table) {
    const rows = Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr'));
    const total = rows.length;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const haystack = row.dataset.search ?? '';
        const show = !q || haystack.includes(q);
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      }
      if (count) {
        count.textContent = q ? `${visible} de ${total} títulos` : `${total} títulos`;
      }
    });
  }
</script>
