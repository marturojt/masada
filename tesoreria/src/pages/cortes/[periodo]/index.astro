---
/*
 * Corte de un mes: borrador mientras está abierto, constancia una vez cerrado.
 * Desde aquí se cierra el mes, se reabre (solo el V∴M∴) y se registran los
 * movimientos de ajuste que corrigen un mes ya cerrado.
 */
import LayoutAdmin from '@layouts/LayoutAdmin.astro';
import Campo from '@componentes/Campo.astro';
import Formulario from '@componentes/Formulario.astro';
import ResumenErrores from '@componentes/ResumenErrores.astro';
import Aviso from '@componentes/Aviso.astro';
import Confirmacion from '@componentes/Confirmacion.astro';
import TablaMovimientos from '@componentes/TablaMovimientos.astro';
import {
  cerrarCorte,
  reabrirCorte,
  guardarMensajeInforme,
  registrarAjuste,
  registrarArqueoInicial,
} from '@lib/casos/cortes';
import { emitirNonce, emitirNonces } from '@lib/csrf';
import {
  aportacionesEspecieDelPeriodo,
  controlBolsas,
  corteDelPeriodo,
  corteGuardado,
  pagosGTDelPeriodo,
  primerMesAbierto,
  reaperturasDe,
  vistaBolsas,
} from '@lib/datos/cortes';
import { estadoAplomo } from '@lib/datos/gt';
import { mensajeDelInforme } from '@lib/datos/informe';
import { sonImagenes } from '@lib/archivos';
import { ajustadosDeVarios, listarMovimientos, saldoDeCaja, totalesPorConcepto } from '@lib/datos/movimientos';
import { listarEgresos, pendientesDeComprobar } from '@lib/datos/egresos';
import { pendientesDeEvidencia } from '@lib/datos/pendientes';
import { formatoMXN } from '@lib/dinero';
import { ErrorDeNegocio } from '@lib/errores';
import {
  esquemaAjuste,
  esquemaArqueo,
  esquemaCierre,
  esquemaMensajeInforme,
  esquemaReapertura,
} from '@lib/esquemas/corte';
import {
  formatoFechaCorta,
  formatoMomento,
  hoyISO,
  nombrePeriodo,
  periodoActual,
  periodoSiguiente,
} from '@lib/fechas';
import { avisoDe, leerFormulario, validar } from '@lib/formulario';
import { esVM, requerirSesion } from '@lib/sesion';
import { cuenta } from '@lib/texto';

const sesion = requerirSesion(Astro);
const soyVM = esVM(sesion);

const periodo = String(Astro.params.periodo ?? '');
if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(periodo)) {
  return new Response('Periodo no válido', { status: 404 });
}

let errores: Record<string, string> = {};
let estado = 200;
let seccion: string | null = null;
/* Lo que se envió, para volver a pintar el formulario tal cual si hubo error. */
let valores: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const entrada = await leerFormulario(Astro);

  if (!entrada.ok) {
    errores = entrada.errores;
    estado = entrada.estado;
  } else {
    const ctxBase = { sesion, idPeticion: Astro.locals.idPeticion };
    seccion = entrada.accion;
    valores = entrada.valores;

    try {
      if (entrada.accion === 'cerrar') {
        const r = await validar(entrada, {
          esquema: esquemaCierre,
          proposito: 'corte_cerrar',
          sesion,
        });
        if (!r.ok) {
          errores = r.errores;
          estado = r.estado;
        } else {
          await cerrarCorte({ ...ctxBase, nonce: r.nonce }, periodo, r.datos.observaciones);
          return Astro.redirect(`/cortes/${periodo}?ok=corte`, 303);
        }
      } else if (entrada.accion === 'reabrir') {
        const r = await validar(entrada, {
          esquema: esquemaReapertura,
          proposito: 'corte_reabrir',
          sesion,
        });
        if (!r.ok) {
          errores = r.errores;
          estado = r.estado;
        } else {
          const guardado = await corteGuardado(periodo);
          if (!guardado) throw new ErrorDeNegocio('Ese mes no tiene corte cerrado.');
          await reabrirCorte({ ...ctxBase, nonce: r.nonce }, guardado.id, r.datos.motivo);
          return Astro.redirect(`/cortes/${periodo}?ok=reabierto`, 303);
        }
      } else if (entrada.accion === 'ajustar') {
        const r = await validar(entrada, {
          esquema: esquemaAjuste,
          proposito: 'movimiento_ajuste',
          sesion,
        });
        if (!r.ok) {
          errores = r.errores;
          estado = r.estado;
        } else {
          await registrarAjuste({ ...ctxBase, nonce: r.nonce }, r.datos.movimiento_id, {
            fecha: r.datos.fecha,
            monto: r.datos.monto,
            motivo: r.datos.motivo,
          });
          return Astro.redirect(`/cortes/${periodo}?ok=ajuste`, 303);
        }
      } else if (entrada.accion === 'mensaje') {
        const r = await validar(entrada, {
          esquema: esquemaMensajeInforme,
          proposito: 'informe_mensaje',
          sesion,
        });
        if (!r.ok) {
          errores = r.errores;
          estado = r.estado;
        } else {
          await guardarMensajeInforme({ ...ctxBase, nonce: r.nonce }, periodo, r.datos.mensaje);
          return Astro.redirect(`/cortes/${periodo}?ok=mensaje#informe`, 303);
        }
      } else if (entrada.accion === 'arqueo') {
        const r = await validar(entrada, {
          esquema: esquemaArqueo,
          proposito: 'arqueo_inicial',
          sesion,
        });
        if (!r.ok) {
          errores = r.errores;
          estado = r.estado;
        } else {
          await registrarArqueoInicial(
            { ...ctxBase, nonce: r.nonce },
            Number(periodo.slice(0, 4)),
            r.datos,
          );
          return Astro.redirect(`/cortes/${periodo}?ok=arqueo`, 303);
        }
      } else {
        errores = { _general: 'Acción no reconocida.' };
        estado = 400;
      }
    } catch (error) {
      if (!(error instanceof ErrorDeNegocio)) throw error;
      errores = { [error.campo ?? '_general']: error.message };
      estado = 422;
    }
  }
}

const calculado = await corteDelPeriodo(periodo);
if (!calculado) return new Response('Ese mes no pertenece a ningún ejercicio', { status: 404 });

const [
  guardado,
  movimientos,
  totales,
  porComprobar,
  especie,
  pagosGT,
  aplomo,
  control,
  mensaje,
  primerAbierto,
  caja,
  egresosEnTramite,
  evidencias,
] = await Promise.all([
    corteGuardado(periodo),
    listarMovimientos({ periodo }),
    totalesPorConcepto(periodo),
    pendientesDeComprobar(),
    aportacionesEspecieDelPeriodo(periodo),
    pagosGTDelPeriodo(periodo),
    estadoAplomo(),
    controlBolsas(calculado.anio),
    mensajeDelInforme(periodo),
    primerMesAbierto(calculado.anio),
    saldoDeCaja(calculado.anio),
    listarEgresos({ anio: calculado.anio, pendientes: true }),
    pendientesDeEvidencia(),
  ]);

const reaperturas = guardado ? await reaperturasDe(guardado.id) : [];
const imagenes = await sonImagenes(
  movimientos.map((m) => m.archivo_id).filter((a): a is number => a !== null),
);
const ajustados = new Map(
  (await ajustadosDeVarios(movimientos.map((m) => m.id))).map((a) => [
    a.movimiento_origen_id,
    a.ajustado,
  ]),
);
const claveAviso = Astro.url.searchParams.get('ok');
const aviso = avisoDe(claveAviso);
const avisoEnlaces =
  claveAviso === 'corte'
    ? [
        { href: `/cortes/${periodo}/imprimir`, texto: 'Imprimir el corte' },
        { href: `/cortes/${periodo}/informe`, texto: 'Ver el informe de tenida' },
        { href: `/cortes/${periodoSiguiente(periodo)}`, texto: `Ir a ${nombrePeriodo(periodoSiguiente(periodo))}` },
      ]
    : claveAviso === 'arqueo'
      ? [{ href: '#cerrar', texto: 'Seguir con el cierre del mes' }]
      : [];

/* Valor enviado si el formulario de esa sección volvió con error; si no, el de siempre. */
const previo = (accion: string, campo: string, porDefecto: string): string =>
  seccion === accion && valores[campo] !== undefined ? valores[campo]! : porDefecto;

const cerrado = guardado?.estado === 'cerrado';
const esFuturo = periodo > periodoActual();

/* Banco y efectivo solo se muestran desde el arranque del control por bolsa. */
const vista = vistaBolsas(control, periodo);
const pideArqueo = control.desde === periodo && control.arqueo === null && !cerrado;
const arqueoDeEsteMes = control.desde === periodo ? control.arqueo : null;

/* Arrastres que impiden cerrar: entregados sin comprobar de meses anteriores. */
const arrastres = porComprobar.filter(
  (p) => p.fecha_entrega.slice(0, 7) < periodo,
);

/*
 * Lo que la base rechazaría al cerrar, dicho antes de apretar el botón. Las
 * reglas viven en fn_cerrar_corte y en el trigger del arqueo; aquí solo se
 * anticipan para no mostrar un botón que va a fallar.
 */
const mesAnteriorAbierto = primerAbierto !== null && primerAbierto < periodo ? primerAbierto : null;
const faltaArqueo = pideArqueo;
const sePuedeCerrar = !mesAnteriorAbierto && !faltaArqueo && arrastres.length === 0;

/* Revisión que no impide cerrar, pero conviene ver antes. */
const finDelMes = `${periodo}-31`;
const egresosSinTerminar = egresosEnTramite.filter(
  (e) => (e.estado === 'registrado' || e.estado === 'autorizado') && e.fecha_solicitud <= finDelMes,
);
const evidenciasDelMes = evidencias.filter((e) => e.fecha.startsWith(periodo));
const gtSinCubrir = !aplomo.cubierto_hasta || aplomo.cubierto_hasta.slice(0, 7) < periodo;

const nonceCierre = await emitirNonce(sesion.idHash, 'corte_cerrar');
const nonceReapertura = await emitirNonce(sesion.idHash, 'corte_reabrir');
const nonceMensaje = esFuturo ? '' : await emitirNonce(sesion.idHash, 'informe_mensaje');
const nonceArqueo = pideArqueo ? await emitirNonce(sesion.idHash, 'arqueo_inicial') : '';
const noncesAjuste = await emitirNonces(
  sesion.idHash,
  'movimiento_ajuste',
  soyVM ? movimientos.length : 0,
);

const ingresos = totales.filter((t) => t.tipo === 'ingreso');
const egresos = totales.filter((t) => t.tipo === 'egreso');

Astro.response.status = estado;
---

<LayoutAdmin titulo={`Corte de ${nombrePeriodo(periodo)}`} sesion={sesion}>
  <div class="barra__contexto" slot="contexto">
    <span><a href="/cortes">← Cortes</a></span>
    <span>Ejercicio {calculado.anio}</span>
    <span><a href={`/cortes/${periodo}/imprimir`}>Imprimir</a></span>
    <span><a href={`/cortes/${periodo}/informe`}>Informe de tenida</a></span>
  </div>

  <Aviso texto={aviso} enlaces={avisoEnlaces} />
  {seccion === null && <ResumenErrores errores={errores} />}

  <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline; justify-content: space-between;">
    <div>
      <h1 style="margin-bottom: 0.2rem;">Corte de {nombrePeriodo(periodo)}</h1>
      <p class="apagado" style="margin: 0;">
        {
          cerrado ? (
            <span class="insignia insignia--ok">Cerrado</span>
          ) : esFuturo ? (
            <span class="apagado">Mes por venir</span>
          ) : (
            <span class="insignia insignia--pendiente">Abierto, es un borrador</span>
          )
        }
        {
          guardado && guardado.reaperturas > 0 && (
            <>
              {' '}
              <span class="insignia insignia--alerta">
                Reabierto {guardado.reaperturas} vez(ces)
              </span>
            </>
          )
        }
      </p>
    </div>
    <a class="btn btn--ghost" href={`/cortes/${periodo}/imprimir`}>Vista para imprimir</a>
  </div>

  <div class="pila" style="margin-top: 1.25rem;">
    <section class="tarjeta">
      <h2>Resumen</h2>
      <div class="tabla-envoltura">
        <table class="tabla">
          <tbody>
            <tr>
              <th scope="row">Saldo inicial</th>
              <td class="num">{formatoMXN(calculado.saldo_inicial_centavos)}</td>
            </tr>
            <tr>
              <th scope="row">Ingresos del mes</th>
              <td class="num">{formatoMXN(calculado.total_ingresos_centavos)}</td>
            </tr>
            <tr>
              <th scope="row">Egresos del mes</th>
              <td class="num">{formatoMXN(calculado.total_egresos_centavos)}</td>
            </tr>
            <tr>
              <th scope="row">Saldo final</th>
              <td class="num">
                <strong>{formatoMXN(calculado.saldo_final_centavos)}</strong>
              </td>
            </tr>
            {
              vista === 'oculta' ? (
                <tr>
                  <th scope="row">Banco y efectivo</th>
                  <td class="num apagado">
                    {control.desde && periodo < control.desde
                      ? `Se llevan desde ${nombrePeriodo(control.desde)}`
                      : 'Pendiente del arqueo inicial'}
                  </td>
                </tr>
              ) : (
                <>
                  <tr>
                    <th scope="row">En banco</th>
                    <td class="num">
                      {vista === 'completa' && (
                        <>{formatoMXN(calculado.banco_inicial_centavos)} →{' '}</>
                      )}
                      {formatoMXN(calculado.banco_final_centavos)}
                    </td>
                  </tr>
                  <tr>
                    <th scope="row">En efectivo</th>
                    <td class="num">
                      {vista === 'completa' && (
                        <>{formatoMXN(calculado.efectivo_inicial_centavos)} →{' '}</>
                      )}
                      {formatoMXN(calculado.efectivo_final_centavos)}
                    </td>
                  </tr>
                </>
              )
            }
            {
              guardado && cerrado && (
                <>
                  <tr>
                    <th scope="row">Cápitas esperadas del mes</th>
                    <td class="num">{formatoMXN(guardado.capitas_esperadas_centavos)}</td>
                  </tr>
                  <tr>
                    <th scope="row">Cápitas cobradas del mes</th>
                    <td class="num">{formatoMXN(guardado.capitas_cobradas_centavos)}</td>
                  </tr>
                  <tr>
                    <th scope="row">Pendiente de comprobar al cierre</th>
                    <td class="num">{formatoMXN(guardado.pendiente_comprobar_centavos)}</td>
                  </tr>
                </>
              )
            }
          </tbody>
        </table>
      </div>

      {
        cerrado && guardado && (
          <p class="apagado" style="font-size: 0.85rem; margin-bottom: 0;">
            Cerrado por {guardado.cerrado_nombre}
            {guardado.cerrado_en && <> el {formatoMomento(guardado.cerrado_en)}</>}.
            {guardado.observaciones && <> {guardado.observaciones}</>}
          </p>
        )
      }
    </section>

    {
      (ingresos.length > 0 || egresos.length > 0) && (
        <section class="tarjeta">
          <h2>Por concepto</h2>
          <div style="display: flex; flex-wrap: wrap; gap: 2rem;">
            <div style="flex: 1; min-width: 15rem;">
              <h3>Ingresos</h3>
              {ingresos.length === 0 ? (
                <p class="apagado">Sin ingresos.</p>
              ) : (
                <div class="tabla-envoltura">
                <table class="tabla">
                  <tbody>
                    {ingresos.map((t) => (
                      <tr>
                        <th scope="row">{t.concepto_nombre}</th>
                        <td class="num">{formatoMXN(t.monto_centavos)}</td>
                      </tr>
                    ))}
                  </tbody>
                  <tfoot>
                    <tr>
                      <td>Total</td>
                      <td class="num">{formatoMXN(calculado.total_ingresos_centavos)}</td>
                    </tr>
                  </tfoot>
                </table>
                </div>
              )}
            </div>
            <div style="flex: 1; min-width: 15rem;">
              <h3>Egresos</h3>
              {egresos.length === 0 ? (
                <p class="apagado">Sin egresos.</p>
              ) : (
                <div class="tabla-envoltura">
                <table class="tabla">
                  <tbody>
                    {egresos.map((t) => (
                      <tr>
                        <th scope="row">{t.concepto_nombre}</th>
                        <td class="num">{formatoMXN(t.monto_centavos)}</td>
                      </tr>
                    ))}
                  </tbody>
                  <tfoot>
                    <tr>
                      <td>Total</td>
                      <td class="num">{formatoMXN(calculado.total_egresos_centavos)}</td>
                    </tr>
                  </tfoot>
                </table>
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    <section class="tarjeta">
      <h2>Gran Tesorería</h2>
      <p class="apagado">
        {aplomo.ordinario_a_plomo
          ? 'La logia está a plomo en lo ordinario'
          : 'Hay obligaciones ordinarias pendientes con la Gran Tesorería'}
        {aplomo.cubierto_hasta && <>, cubierta hasta {nombrePeriodo(aplomo.cubierto_hasta.slice(0, 7))}</>}
        {aplomo.regularizaciones_pendientes > 0 && (
          <>, {cuenta(aplomo.regularizaciones_pendientes, 'regularización pendiente', 'regularizaciones pendientes')}</>
        )}. El detalle vive en <a href="/gran-tesoreria">Gran Tesorería</a>.
      </p>
      {
        pagosGT.length === 0 ? (
          <p class="apagado">Sin pagos a la Gran Tesorería en este mes.</p>
        ) : (
          <div class="tabla-envoltura">
          <table class="tabla">
            <thead>
              <tr>
                <th scope="col">Pago</th>
                <th scope="col">Fecha</th>
                <th scope="col">Obligaciones que cubre</th>
                <th scope="col" class="num">Monto</th>
              </tr>
            </thead>
            <tbody>
              {pagosGT.map((pgt) => (
                <tr>
                  <td>{pgt.folio}</td>
                  <td>{formatoFechaCorta(pgt.fecha_pago)}</td>
                  <td>{pgt.obligaciones ?? ''}</td>
                  <td class="num">{formatoMXN(pgt.monto_centavos)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        )
      }
    </section>

    {
      especie.length > 0 && (
        <section class="tarjeta">
          <h2>Aportaciones en especie del mes</h2>
          <p class="apagado">
            Constan en el informe pero fuera de las cifras: no son dinero y no entran en
            ningún saldo.
          </p>
          <div class="tabla-envoltura">
            <table class="tabla">
              <thead>
                <tr>
                  <th scope="col">Folio</th>
                  <th scope="col">Fecha</th>
                  <th scope="col">Aportante</th>
                  <th scope="col">Lo aportado</th>
                  <th scope="col" class="num">Valor estimado</th>
                </tr>
              </thead>
              <tbody>
                {especie.map((a) => (
                  <tr>
                    <td>
                      <a href={`/aportaciones/${a.id}/constancia`}>{a.folio}</a>
                    </td>
                    <td>{formatoFechaCorta(a.fecha)}</td>
                    <td>{a.aportante_nombre}</td>
                    <td>
                      {a.descripcion}
                      {a.cantidad && <> · {Number(a.cantidad)} {a.unidad ?? (Number(a.cantidad) === 1 ? 'pieza' : 'piezas')}</>}
                      {a.destino && <> · {a.destino}</>}
                    </td>
                    <td class="num">
                      {a.valor_estimado_centavos != null
                        ? `≈ ${formatoMXN(a.valor_estimado_centavos)}`
                        : 'Sin valuar'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section class="tarjeta">
      <h2>Movimientos del mes</h2>
      <TablaMovimientos
        movimientos={movimientos}
        titulo={cuenta(movimientos.length, 'movimiento', 'movimientos')}
        conSigno
        ajustados={ajustados}
        imagenes={imagenes}
        netearTotal={false}
        vacio="Sin movimientos en este mes."
      />

      {
        soyVM && movimientos.length > 0 && (
          <details style="margin-top: 1rem;" open={seccion === 'ajustar'}>
            <summary style="cursor: pointer;">Corregir un movimiento con un ajuste</summary>
            <div style="margin-top: 0.75rem;">
              <p class="apagado" style="font-size: 0.85rem;">
                {cerrado
                  ? 'El mes está cerrado, así que no se edita: se registra un movimiento de signo contrario en el mes abierto, ligado al original.'
                  : 'El libro no borra movimientos, ni siquiera en un mes abierto: una captura equivocada se corrige con uno de signo contrario ligado al original. Si además era un pago de cápita, los meses que cubría se liberan solos.'}
              </p>
              {seccion === 'ajustar' && <ResumenErrores errores={errores} />}
              <div class="tabla-envoltura">
                <table class="tabla">
                  <thead>
                    <tr>
                      <th scope="col">Movimiento</th>
                      <th scope="col" class="num">Monto</th>
                      <th scope="col">Ajuste</th>
                    </tr>
                  </thead>
                  <tbody>
                    {movimientos.map((m, i) => (
                      <tr>
                        <td>
                          {formatoFechaCorta(m.fecha)} · {m.concepto_nombre}
                          {m.hermano_nombre && <> · <strong>{m.hermano_nombre}</strong></>}
                          <br />
                          <span class="apagado" style="font-size: 0.8rem;">
                            {m.descripcion}
                          </span>
                          {(ajustados.get(m.id) ?? 0) > 0 && (
                            <>
                              <br />
                              <span class="insignia insignia--pendiente">
                                Ya ajustado por {formatoMXN(ajustados.get(m.id) ?? 0)}, neto{' '}
                                {formatoMXN(m.monto_centavos - (ajustados.get(m.id) ?? 0))}
                              </span>
                            </>
                          )}
                        </td>
                        <td class="num">{formatoMXN(m.monto_centavos)}</td>
                        <td>
                          {m.es_ajuste ? (
                            <span class="apagado">Es un ajuste</span>
                          ) : (
                          <Formulario
                            csrf={sesion.csrfToken}
                            nonce={noncesAjuste[i] ?? ''}
                            accionInterna="ajustar"
                          >
                            <input type="hidden" name="movimiento_id" value={String(m.id)} />
                            <Campo
                              nombre="fecha"
                              etiqueta="Fecha del ajuste"
                              tipo="date"
                              valor={hoyISO()}
                              requerido
                            />
                            <Campo
                              nombre="monto"
                              etiqueta="Monto a restar"
                              modoTeclado="decimal"
                              monto
                              requerido
                              ayuda={`Lo que se RESTA, no el total corregido: para dejar ${formatoMXN(m.monto_centavos)} en ${formatoMXN(m.monto_centavos - 25000)}, el ajuste es $250.00.`}
                            />
                            <Campo nombre="motivo" etiqueta="Motivo" requerido />
                            <div class="formulario__acciones">
                              <button
                                class="btn btn--ghost"
                                type="submit"
                                style="padding: 0.2rem 0.7rem; font-size: 0.75rem;"
                              >
                                Registrar ajuste
                              </button>
                            </div>
                          </Formulario>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </details>
        )
      }
    </section>

    {
      !esFuturo && (
        <section class="tarjeta" id="informe">
          <h2>Informe de tenida</h2>
          <p class="apagado" style="font-size: 0.9rem;">
            El informe que se lee a los hermanos lleva un texto que arma el sistema con las
            cifras de este mes y, debajo, tu mensaje. No nombra a quienes deben, solo da
            cifras. El mensaje se puede escribir o corregir aunque el mes ya esté cerrado.
          </p>
          {seccion === 'mensaje' && <ResumenErrores errores={errores} />}
          <div style="max-width: 40rem;">
            <Formulario csrf={sesion.csrfToken} nonce={nonceMensaje} accionInterna="mensaje">
              <Campo
                nombre="mensaje"
                etiqueta="Mensaje del tesorero"
                valor={previo('mensaje', 'mensaje', mensaje?.mensaje ?? '')}
                error={errores.mensaje}
                ayuda={
                  mensaje
                    ? `Guardado por ${mensaje.actualizado_nombre ?? 'la tesorería'} el ${formatoMomento(mensaje.actualizado_en)}; déjalo vacío para quitarlo.`
                    : 'Opcional. Por ejemplo, un agradecimiento, un recordatorio de pago o lo que viene el próximo mes.'
                }
                largo
                filas={5}
              />
              <div class="formulario__acciones">
                <button class="btn btn--primary" type="submit">Guardar mensaje</button>
                <a class="btn btn--ghost" href={`/cortes/${periodo}/informe`}>Ver el informe</a>
              </div>
            </Formulario>
          </div>
        </section>
      )
    }

    {
      pideArqueo && (
        <section class="tarjeta" id="arqueo">
          <h2>Arqueo inicial</h2>
          <p class="apagado" style="font-size: 0.9rem;">
            Desde {nombrePeriodo(periodo)} se lleva por separado lo que hay en el banco y lo
            que hay en efectivo. Para arrancar, cuenta el sobre y revisa el saldo del banco
            el mismo día, y anota aquí las dos cantidades. El sistema registra el traspaso
            que haga falta para que el desglose quede igual a lo contado. El total no cambia.
          </p>
          <p class="apagado" style="font-size: 0.9rem;">
            Las dos cantidades deben sumar <strong>{formatoMXN(caja.saldo)}</strong>, que es
            lo que el sistema tiene registrado del ejercicio. Si no suman, falta capturar
            algo o registrar un ajuste. Este mes no se puede cerrar sin el arqueo, y el
            arqueo se hace una sola vez.
          </p>

          {seccion === 'arqueo' && <ResumenErrores errores={errores} />}

          <div style="max-width: 30rem;">
            <Formulario csrf={sesion.csrfToken} nonce={nonceArqueo} accionInterna="arqueo">
              <Campo
                nombre="fecha"
                etiqueta="Fecha del arqueo"
                tipo="date"
                valor={previo('arqueo', 'fecha', hoyISO().startsWith(periodo) ? hoyISO() : `${periodo}-01`)}
                error={errores.fecha}
                requerido
              />
              <Campo
                nombre="banco"
                etiqueta="En el banco"
                valor={previo('arqueo', 'banco', '')}
                modoTeclado="decimal"
                monto
                error={errores.banco}
                ayuda="El saldo del estado de cuenta o de la banca en línea ese día."
                requerido
              />
              <Campo
                nombre="efectivo"
                etiqueta="En efectivo"
                valor={previo('arqueo', 'efectivo', '')}
                modoTeclado="decimal"
                monto
                error={errores.efectivo}
                ayuda="Lo que hay contado en el sobre."
                requerido
              />
              <div class="formulario__acciones">
                <button class="btn btn--primary" type="submit">Registrar arqueo</button>
              </div>
            </Formulario>
          </div>
        </section>
      )
    }

    {
      arqueoDeEsteMes && (
        <section class="tarjeta">
          <h2>Arqueo inicial</h2>
          <p class="apagado" style="font-size: 0.9rem; margin-bottom: 0;">
            El {formatoFechaCorta(arqueoDeEsteMes.fecha)} se contaron{' '}
            {formatoMXN(arqueoDeEsteMes.banco_contado_centavos)} en el banco y{' '}
            {formatoMXN(arqueoDeEsteMes.efectivo_contado_centavos)} en efectivo. El sistema
            traía {formatoMXN(arqueoDeEsteMes.banco_sistema_centavos)} en el banco
            {arqueoDeEsteMes.traspaso_id
              ? ', así que se registró un traspaso por la diferencia.'
              : ', así que no hizo falta traspaso.'}{' '}
            Lo registró {arqueoDeEsteMes.creado_nombre}.
          </p>
        </section>
      )
    }

    {
      !cerrado && !esFuturo && (
        <section class="tarjeta" id="cerrar">
          <h2>Cerrar el mes</h2>
          <p class="apagado" style="font-size: 0.9rem;">
            {movimientos.length === 0
              ? `Al cerrar, ${nombrePeriodo(periodo)} queda sellado sin movimientos y deja de admitir capturas.`
              : movimientos.length === 1
                ? `Al cerrar, el único movimiento de ${nombrePeriodo(periodo)} queda sellado y el mes deja de admitir capturas.`
                : `Al cerrar, los ${movimientos.length} movimientos de ${nombrePeriodo(periodo)} quedan sellados y el mes deja de admitir capturas.`}
            El saldo final de {formatoMXN(calculado.saldo_final_centavos)} pasa a ser el
            saldo inicial del mes siguiente.
          </p>

          {!sePuedeCerrar && (
            <div class="aviso aviso--error">
              <p>Todavía no se puede cerrar {nombrePeriodo(periodo)}:</p>
              <ul>
                {mesAnteriorAbierto && (
                  <li>
                    Antes hay que cerrar{' '}
                    <a href={`/cortes/${mesAnteriorAbierto}`}>{nombrePeriodo(mesAnteriorAbierto)}</a>.
                  </li>
                )}
                {faltaArqueo && (
                  <li>
                    Falta el <a href="#arqueo">arqueo inicial</a>: contar el efectivo y anotar
                    el saldo del banco.
                  </li>
                )}
                {arrastres.map((a) => (
                  <li>
                    Falta comprobar el egreso <a href={`/egresos/${a.id}`}>{a.folio}</a>,
                    entregado el {formatoFechaCorta(a.fecha_entrega)}: faltan{' '}
                    {formatoMXN(a.pendiente_centavos)} entre recibos y devolución.
                  </li>
                ))}
              </ul>
            </div>
          )}

          {sePuedeCerrar && (egresosSinTerminar.length > 0 || evidenciasDelMes.length > 0 || gtSinCubrir) && (
            <div class="aviso">
              <p>Antes de cerrar, revisa:</p>
              <ul>
                {egresosSinTerminar.length > 0 && (
                  <li>
                    {egresosSinTerminar.length === 1
                      ? 'Hay un egreso esperando firma o entrega'
                      : `Hay ${egresosSinTerminar.length} egresos esperando firma o entrega`}
                    {' '}(<a href="/egresos">ver egresos</a>). Si el dinero ya salió este mes,
                    registra la entrega antes de cerrar.
                  </li>
                )}
                {evidenciasDelMes.length > 0 && (
                  <li>
                    {evidenciasDelMes.length === 1
                      ? 'Un movimiento del mes no tiene comprobante'
                      : `${evidenciasDelMes.length} movimientos del mes no tienen comprobante`}{' '}
                    (<a href="/pendientes">ver pendientes</a>). Se puede adjuntar después.
                  </li>
                )}
                {gtSinCubrir && (
                  <li>
                    La cuota ordinaria de {nombrePeriodo(periodo)} con la Gran Tesorería
                    todavía no está pagada (<a href="/gran-tesoreria">ver Gran Tesorería</a>).
                  </li>
                )}
              </ul>
            </div>
          )}

          {seccion === 'cerrar' && <ResumenErrores errores={errores} />}

          {sePuedeCerrar && (
            <div style="max-width: 30rem;">
              <Formulario csrf={sesion.csrfToken} nonce={nonceCierre} accionInterna="cerrar">
                <Campo
                  nombre="observaciones"
                  etiqueta="Observaciones del corte"
                  valor={previo('cerrar', 'observaciones', '')}
                  error={errores.observaciones}
                  ayuda="Opcional. Se imprime en la hoja del corte."
                  largo
                  filas={3}
                />
                <Confirmacion
                  texto={`Revisé los movimientos y entiendo que, una vez cerrado, ${nombrePeriodo(periodo)} ya no se puede cambiar. Solo el V∴M∴ puede reabrirlo.`}
                  error={seccion === 'cerrar' ? errores.confirmo : undefined}
                />
                <div class="formulario__acciones">
                  <button class="btn btn--primary" type="submit">
                    Cerrar {nombrePeriodo(periodo)}
                  </button>
                </div>
              </Formulario>
            </div>
          )}
        </section>
      )
    }

    {
      cerrado && (
        <section class="tarjeta">
          <h2>Reapertura</h2>
          {reaperturas.length > 0 && (
            <ul style="font-size: 0.85rem;">
              {reaperturas.map((r) => (
                <li>
                  {formatoMomento(r.reabierto_en)} · {r.reabierto_nombre}: {r.motivo}
                </li>
              ))}
            </ul>
          )}

          {soyVM ? (
            <details open={seccion === 'reabrir'}>
              <summary style="cursor: pointer;">Reabrir este corte</summary>
              <div style="margin-top: 0.75rem; max-width: 30rem;">
                <p class="apagado" style="font-size: 0.85rem;">
                  Es excepcional y queda registrado para siempre. Lo normal es corregir con
                  un movimiento de ajuste en el mes abierto. Solo se puede reabrir el
                  último mes cerrado.
                </p>
                {seccion === 'reabrir' && <ResumenErrores errores={errores} />}
                <Formulario
                  csrf={sesion.csrfToken}
                  nonce={nonceReapertura}
                  accionInterna="reabrir"
                >
                  <Campo
                    nombre="motivo"
                    etiqueta="Motivo de la reapertura"
                    valor={previo('reabrir', 'motivo', '')}
                    error={errores.motivo}
                    requerido
                  />
                  <div class="formulario__acciones">
                    <button class="btn btn--ghost" type="submit">Reabrir corte</button>
                  </div>
                </Formulario>
              </div>
            </details>
          ) : (
            <p class="apagado" style="font-size: 0.85rem; margin-bottom: 0;">
              La reapertura de un corte la autoriza el Venerable Maestro.
            </p>
          )}
        </section>
      )
    }
  </div>
</LayoutAdmin>
