---
/* Cortes del ejercicio, mes por mes, con los saldos encadenados. */
import { cuenta } from '@lib/texto';
import LayoutAdmin from '@layouts/LayoutAdmin.astro';
import Aviso from '@componentes/Aviso.astro';
import { controlBolsas, cortesDelAnio, vistaBolsas } from '@lib/datos/cortes';
import { anioDeUrl, ejercicioVigente, listarEjercicios } from '@lib/datos/ejercicios';
import { formatoMXN } from '@lib/dinero';
import { formatoFechaCorta, formatoMomento, nombrePeriodo, periodoActual } from '@lib/fechas';
import { avisoDe } from '@lib/formulario';
import { requerirSesion } from '@lib/sesion';

const sesion = requerirSesion(Astro);
const aviso = avisoDe(Astro.url.searchParams.get('ok'));

const ejercicios = await listarEjercicios();
const vigente = await ejercicioVigente();
const anio = anioDeUrl(Astro.url, ejercicios, vigente.anio);
const ejercicio = ejercicios.find((e) => e.anio === anio) ?? vigente;

const [cortes, control] = await Promise.all([cortesDelAnio(anio), controlBolsas(anio)]);
const hoy = periodoActual();

const cerrados = cortes.filter((c) => c.estado_corte === 'cerrado');
const ultimoCerrado = cerrados.at(-1);
const saldoActual = cortes.find((c) => c.periodo.slice(0, 7) === hoy)?.saldo_final_centavos;
---

<LayoutAdmin titulo="Cortes mensuales" sesion={sesion}>
  <div class="barra__contexto" slot="contexto">
    <span>Ejercicio {anio}</span>
    <span>Saldo de apertura: {formatoMXN(ejercicio.saldo_apertura_centavos)}</span>
    {saldoActual !== undefined && <span>Saldo a hoy: {formatoMXN(saldoActual)}</span>}
    <span>{cerrados.length} de 12 meses cerrados</span>
  </div>

  <Aviso texto={aviso} />

  <h1>Cortes mensuales {anio}</h1>
  <p class="apagado">
    Cada mes se cierra en orden. Al cerrarlo, sus movimientos quedan sellados y el mes
    ya no admite capturas: una corrección posterior se hace con un movimiento de ajuste
    en el mes abierto.
  </p>

  {
    ejercicio.saldo_apertura_centavos === 0 && (
      <div class="aviso aviso--error">
        El saldo de apertura de {anio} está en cero. Si la logia traía dinero de antes,
        captúralo en <a href="/herramientas">Herramientas</a> antes de cerrar el primer
        mes, porque de ahí se encadenan todos los saldos.
      </div>
    )
  }

  {
    control.desde && (
      <p class="apagado letra-media">
        Banco y efectivo se llevan por separado desde {nombrePeriodo(control.desde)}
        {control.arqueo
          ? `, con el arqueo inicial del ${formatoFechaCorta(control.arqueo.fecha)}.`
          : '. Falta el arqueo inicial, que se registra en el corte de ese mes.'}{' '}
        Antes de eso el corte informa solo el total.
      </p>
    )
  }

  <div class="tabla-envoltura">
    <table class="tabla">
      <caption>Saldos encadenados</caption>
      <thead>
        <tr>
          <th scope="col">Mes</th>
          <th scope="col" class="num">Saldo inicial</th>
          <th scope="col" class="num">Ingresos</th>
          <th scope="col" class="num">Egresos</th>
          <th scope="col" class="num">Saldo final</th>
          <th scope="col" class="num">Banco</th>
          <th scope="col" class="num">Efectivo</th>
          <th scope="col">Estado</th>
          <th scope="col">Acción</th>
        </tr>
      </thead>
      <tbody>
        {
          cortes.map((c) => {
            const periodo = c.periodo.slice(0, 7);
            const futuro = periodo > hoy;
            return (
              <tr>
                <td>
                  <a href={`/cortes/${periodo}`}>{nombrePeriodo(periodo)}</a>
                </td>
                <td class="num">{formatoMXN(c.saldo_inicial_centavos)}</td>
                <td class="num">{formatoMXN(c.total_ingresos_centavos)}</td>
                <td class="num">{formatoMXN(c.total_egresos_centavos)}</td>
                <td class="num">{formatoMXN(c.saldo_final_centavos)}</td>
                {vistaBolsas(control, periodo) === 'oculta' ? (
                  <>
                    <td class="num apagado">—</td>
                    <td class="num apagado">—</td>
                  </>
                ) : (
                  <>
                    <td class="num">{formatoMXN(c.banco_final_centavos)}</td>
                    <td class="num">{formatoMXN(c.efectivo_final_centavos)}</td>
                  </>
                )}
                <td>
                  {c.estado_corte === 'cerrado' ? (
                    <>
                      <span class="insignia insignia--ok">Cerrado</span>
                      {(c.reaperturas ?? 0) > 0 && (
                        <>
                          {' '}
                          <span class="insignia insignia--alerta">
                            Reabierto {cuenta(c.reaperturas ?? 0, 'vez', 'veces')}
                          </span>
                        </>
                      )}
                    </>
                  ) : futuro ? (
                    <span class="insignia insignia--neutro">Por venir</span>
                  ) : (
                    <span class="insignia insignia--pendiente">Abierto</span>
                  )}
                </td>
                <td>
                  {/* Una sola acción: el enlace del mes ya lleva a revisarlo. */}
                  {c.estado_corte === 'cerrado' ? (
                    <a class="btn btn--ghost btn--chico" href={`/cortes/${periodo}/imprimir`}>
                      Imprimir
                    </a>
                  ) : futuro ? (
                    <span class="apagado">—</span>
                  ) : (
                    <a class="btn btn--primary btn--chico" href={`/cortes/${periodo}#cerrar`}>
                      Cerrar
                    </a>
                  )}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  {
    ultimoCerrado && (
      <p class="apagado letra-chica">
        Último mes cerrado: {nombrePeriodo(ultimoCerrado.periodo.slice(0, 7))}
        {ultimoCerrado.cerrado_nombre && <> por {ultimoCerrado.cerrado_nombre}</>}
        {ultimoCerrado.cerrado_en && <> el {formatoMomento(ultimoCerrado.cerrado_en)}</>}.
      </p>
    )
  }
</LayoutAdmin>
