---
/* Padrón de hermanos, con filtros por estatus y grado en la barra de direcciones. */
import LayoutAdmin from '@layouts/LayoutAdmin.astro';
import Aviso from '@componentes/Aviso.astro';
import { avisoDe } from '@lib/formulario';
import { requerirSesion } from '@lib/sesion';
import { listarCandidatos, listarHermanos, resumenPadron } from '@lib/datos/hermanos';
import { NOMBRE_EVENTO_CUOTA, cuotasPorCobrar } from '@lib/datos/cuotas';
import { formatoMXN } from '@lib/dinero';
import { anioDeUrl, ejercicioVigente, listarEjercicios } from '@lib/datos/ejercicios';
import { formatoFechaCorta } from '@lib/fechas';
import { NOMBRE_GRADO, NOMBRE_GRADO_PLURAL, type Grado } from '@lib/tipos';
import { NOMBRE_MOTIVO_BAJA } from '@lib/esquemas/hermano';
import { cuenta } from '@lib/texto';

const sesion = requerirSesion(Astro);
const aviso = avisoDe(Astro.url.searchParams.get('ok'));

const ejercicios = await listarEjercicios();
const vigente = await ejercicioVigente();
const anio = anioDeUrl(Astro.url, ejercicios, vigente.anio);

const estatusCrudo = Astro.url.searchParams.get('estatus') ?? 'activo';
const estatus = (['activo', 'baja', 'todos'] as const).includes(estatusCrudo as 'activo')
  ? (estatusCrudo as 'activo' | 'baja' | 'todos')
  : 'activo';

const gradoCrudo = Astro.url.searchParams.get('grado');
const grado = (['aprendiz', 'companero', 'maestro'] as const).includes(gradoCrudo as Grado)
  ? (gradoCrudo as Grado)
  : undefined;

const hermanos = await listarHermanos({ anio, estatus, grado });
const [resumen, candidatos, cuotas] = await Promise.all([
  resumenPadron(),
  listarCandidatos(),
  cuotasPorCobrar(),
]);
const enProceso = candidatos.filter((c) => c.estatus === 'candidato').length;
const totalActivos = resumen.reduce((suma, r) => suma + r.activos, 0);

const conFiltro = (cambios: Record<string, string | undefined>): string => {
  const params = new URLSearchParams(Astro.url.searchParams);
  for (const [clave, valor] of Object.entries(cambios)) {
    if (valor === undefined) params.delete(clave);
    else params.set(clave, valor);
  }
  const cadena = params.toString();
  return cadena ? `/hermanos?${cadena}` : '/hermanos';
};
---

<LayoutAdmin titulo="Hermanos" sesion={sesion}>
  <div class="barra__contexto" slot="contexto">
    <span>Ejercicio {anio}</span>
    <span>{totalActivos} hermanos activos</span>
    {
      resumen.map((r) => (
        <span>
          {NOMBRE_GRADO_PLURAL[r.grado]}: {r.activos}
        </span>
      ))
    }
  </div>

  <Aviso texto={aviso} />

  <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline; justify-content: space-between;">
    <h1>Padrón</h1>
    <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
      <a class="btn btn--primary" href="/hermanos/nuevo">Alta de hermano</a>
      <a class="btn btn--ghost" href="/hermanos/candidatos">Candidatos ({enProceso})</a>
    </div>
  </div>

  <p class="apagado" style="font-size: 0.85rem;">
    Filtrar:
    {
      (
        [
          ['activo', 'Activos'],
          ['baja', 'Bajas'],
          ['todos', 'Todos'],
        ] as const
      ).map(([valor, texto]) => (
        <>
          {' '}
          <a
            href={conFiltro({ estatus: valor })}
            style={estatus === valor ? 'color: var(--gold); font-weight: 600;' : undefined}
          >
            {texto}
          </a>
        </>
      ))
    }
    {' · '}
    <a href={conFiltro({ grado: undefined })} style={!grado ? 'color: var(--gold); font-weight: 600;' : undefined}>
      Todos los grados
    </a>
    {
      (['maestro', 'companero', 'aprendiz'] as const).map((g) => (
        <>
          {' '}
          <a
            href={conFiltro({ grado: g })}
            style={grado === g ? 'color: var(--gold); font-weight: 600;' : undefined}
          >
            {NOMBRE_GRADO_PLURAL[g]}
          </a>
        </>
      ))
    }
  </p>

  {
    hermanos.length === 0 ? (
      <div class="tarjeta">
        <p style="margin: 0;">
          No hay hermanos con ese filtro. Empieza con
          <a href="/hermanos/nuevo">el alta de un hermano</a>, o importa el cuadro del sitio
          con <code>npm run sembrar -- --desde-sitio</code>.
        </p>
      </div>
    ) : (
      <div class="tabla-envoltura">
        <table class="tabla">
          <caption>
            {cuenta(hermanos.length, 'hermano', 'hermanos')}
          </caption>
          <thead>
            <tr>
              <th scope="col">Nombre</th>
              <th scope="col">Grado</th>
              <th scope="col">Cargo {anio}</th>
              <th scope="col">Ingreso</th>
              <th scope="col">Estatus</th>
            </tr>
          </thead>
          <tbody>
            {hermanos.map((h) => (
              <tr>
                <td>
                  <a href={`/hermanos/${h.id}`}>{h.nombre_completo}</a>
                </td>
                <td>{NOMBRE_GRADO[h.grado]}</td>
                <td>{h.cargo_nombre ?? <span class="apagado">—</span>}</td>
                <td>{formatoFechaCorta(h.fecha_ingreso)}</td>
                <td>
                  {h.estatus === 'activo' ? (
                    <span class="insignia insignia--ok">Activo</span>
                  ) : (
                    <span class="insignia insignia--alerta">
                      {h.motivo_baja ? NOMBRE_MOTIVO_BAJA[h.motivo_baja] : 'Baja'}
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    cuotas.length > 0 && (
      <section class="tarjeta" id="cuotas" style="margin-top: 1.5rem;">
        <h2>Cuotas de grado por cobrar</h2>
        <p class="apagado" style="font-size: 0.85rem;">
          Lo que hermanos y candidatos deben a la logia por su iniciación, afiliación,
          aumento o exaltación. Se salda capturando el ingreso de la cuota a su nombre.
        </p>
        <div class="tabla-envoltura">
          <table class="tabla">
            <thead>
              <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Cuota</th>
                <th scope="col">Desde</th>
                <th scope="col" class="num">Pagado</th>
                <th scope="col" class="num">Debe</th>
              </tr>
            </thead>
            <tbody>
              {cuotas.map((c) => (
                <tr>
                  <td>
                    <a href={`/hermanos/${c.hermano_id}#cuotas`}>{c.nombre_completo}</a>
                    {c.hermano_estatus === 'candidato' && <span class="apagado"> · candidato</span>}
                  </td>
                  <td>{NOMBRE_EVENTO_CUOTA[c.tipo_evento]}</td>
                  <td>{formatoFechaCorta(c.fecha)}</td>
                  <td class="num">{formatoMXN(c.pagado_centavos)}</td>
                  <td class="num"><strong>{formatoMXN(c.saldo_centavos)}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</LayoutAdmin>
