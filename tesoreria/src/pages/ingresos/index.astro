---
/*
 * Ingresos que no son cápita: cuotas de grado del candidato, donativos y otros.
 * Las cápitas viven en su propio módulo porque hay que aplicarlas a los meses
 * que cubren.
 */
import LayoutAdmin from '@layouts/LayoutAdmin.astro';
import TablaMovimientos from '@componentes/TablaMovimientos.astro';
import Aviso from '@componentes/Aviso.astro';
import { anioDeUrl, ejercicioVigente, listarEjercicios } from '@lib/datos/ejercicios';
import { sonImagenes } from '@lib/archivos';
import { ajustadosDeVarios, foliosDeRecibo, listarMovimientos } from '@lib/datos/movimientos';
import { formatoMXN } from '@lib/dinero';
import { avisoDe, idDeUrl } from '@lib/formulario';
import { requerirSesion } from '@lib/sesion';
import { cuenta } from '@lib/texto';

const sesion = requerirSesion(Astro);
const aviso = avisoDe(Astro.url.searchParams.get('ok'));

const ejercicios = await listarEjercicios();
const vigente = await ejercicioVigente();
const anio = anioDeUrl(Astro.url, ejercicios, vigente.anio);

/* Todo ingreso menos las cápitas, que tienen su propia pantalla. */
const movimientos = await listarMovimientos({
  anio,
  tipo: 'ingreso',
  tiposEspeciales: ['cuota_grado', 'donativo', 'devolucion_por_comprobar', 'otro'],
});

const folios = new Map(
  (await foliosDeRecibo(movimientos.map((m) => m.id))).map((f) => [f.movimiento_id, f.folio]),
);

/* Los ajustes ligados: el libro no reescribe la fila, pero aquí se ve el neto. */
const ajustados = new Map(
  (await ajustadosDeVarios(movimientos.map((m) => m.id))).map((a) => [
    a.movimiento_origen_id,
    a.ajustado,
  ]),
);
const imagenes = await sonImagenes(
  movimientos.map((m) => m.archivo_id).filter((a): a is number => a !== null),
);

const netoDe = (m: { id: number; monto_centavos: number }): number =>
  m.monto_centavos - (ajustados.get(m.id) ?? 0);

const porTipo = new Map<string, number>();
for (const m of movimientos) {
  porTipo.set(m.concepto_nombre, (porTipo.get(m.concepto_nombre) ?? 0) + netoDe(m));
}
const total = movimientos.reduce((s, m) => s + netoDe(m), 0);

/* Tras registrar: el recibo del ingreso recién guardado, si es de esta lista y lleva folio. */
const movAviso = idDeUrl(Astro.url, 'mov');
const avisoEnlaces = [
  ...(movAviso && folios.has(movAviso)
    ? [{ href: `/recibos/${movAviso}`, texto: `Ver e imprimir el recibo ${folios.get(movAviso)}` }]
    : []),
  ...(aviso ? [{ href: '/ingresos/nuevo', texto: 'Registrar otro ingreso' }] : []),
];
const totalAjustado = movimientos.reduce((s, m) => s + (ajustados.get(m.id) ?? 0), 0);
---

<LayoutAdmin titulo="Ingresos" sesion={sesion}>
  <div class="barra__contexto" slot="contexto">
    <span>Ejercicio {anio}</span>
    <span>
      Ingresos distintos de cápita: {formatoMXN(total)}
      {totalAjustado > 0 && ' (neto de ajustes)'}
    </span>
  </div>

  <Aviso texto={aviso} enlaces={avisoEnlaces} />

  <div class="encabezado">
    <h1>Ingresos</h1>
    <a class="btn btn--primary" href="/ingresos/nuevo">Registrar ingreso</a>
  </div>

  <p class="apagado letra-media">
    Aquí van las cuotas de grado que paga el candidato, los donativos y las
    devoluciones de gastos por comprobar. Las cápitas se registran en
    <a href="/capitas">Cápitas</a>.
  </p>

  {
    porTipo.size > 0 && (
      <section class="tarjeta abajo-l">
        <h2>Por concepto</h2>
        <div class="tabla-envoltura">
          <table class="tabla">
            <tbody>
              {[...porTipo.entries()].map(([nombre, monto]) => (
                <tr>
                  <th scope="row">{nombre}</th>
                  <td class="num">{formatoMXN(monto)}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr>
                <td>Total</td>
                <td class="num">{formatoMXN(total)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    )
  }

  <TablaMovimientos
    conAdjuntar
    ajustados={ajustados}
    imagenes={imagenes}
    movimientos={movimientos}
    titulo={`${cuenta(movimientos.length, 'movimiento', 'movimientos')} de ingreso en ${anio}`}
    folios={folios}
    vacio="Todavía no hay ingresos distintos de cápita en este ejercicio."
  />
</LayoutAdmin>
