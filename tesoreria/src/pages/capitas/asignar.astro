---
/*
 * Asignación de modalidad de cápita. Las reglas las impone la base:
 *   mensual     solo para quien viene desde enero
 *   promoción   solo para quien viene desde enero, y la autoriza el V∴M∴
 *   prorrateo   para quien ingresa dentro del año
 */
import LayoutAdmin from '@layouts/LayoutAdmin.astro';
import Campo from '@componentes/Campo.astro';
import Formulario from '@componentes/Formulario.astro';
import ResumenErrores from '@componentes/ResumenErrores.astro';
import Selector from '@componentes/Selector.astro';
import { asignarModalidad } from '@lib/casos/capitas';
import { emitirNonce } from '@lib/csrf';
import { NOMBRE_MODALIDAD, estadosDeCuenta, sinPlan } from '@lib/datos/capitas';
import { anioDeUrl, ejercicioVigente, listarEjercicios } from '@lib/datos/ejercicios';
import { hermanosActivos } from '@lib/datos/hermanos';
import { formatoMXN } from '@lib/dinero';
import { ErrorDeNegocio } from '@lib/errores';
import { esquemaModalidad } from '@lib/esquemas/capita';
import { MESES, mesActual } from '@lib/fechas';
import { procesarFormulario } from '@lib/formulario';
import { esVM, requerirSesion } from '@lib/sesion';
import { NOMBRE_GRADO_PLURAL, type Opcion } from '@lib/tipos';

const sesion = requerirSesion(Astro);
const puedePromocion = esVM(sesion);

const ejercicios = await listarEjercicios();
const vigente = await ejercicioVigente();
const anio = anioDeUrl(Astro.url, ejercicios, vigente.anio);
const ejercicio = ejercicios.find((e) => e.anio === anio) ?? vigente;

const ETIQUETAS: Record<string, string> = {
  hermano_id: 'Hermano',
  modalidad: 'Modalidad',
  mes_promocion: 'Mes de la promoción',
  motivo: 'Motivo',
};

let errores: Record<string, string> = {};
let valores: Record<string, string> = {
  hermano_id: Astro.url.searchParams.get('hermano') ?? '',
  modalidad: 'mensual',
  mes_promocion: String(mesActual()),
};
let estado = 200;

if (Astro.request.method === 'POST') {
  const resultado = await procesarFormulario(Astro, {
    esquema: esquemaModalidad,
    proposito: 'capita_modalidad',
    sesion,
  });

  if (!resultado.ok) {
    errores = resultado.errores;
    valores = { ...valores, ...resultado.valores };
    estado = resultado.estado;
  } else {
    try {
      await asignarModalidad(
        { sesion, nonce: resultado.nonce, anio, idPeticion: Astro.locals.idPeticion },
        resultado.datos,
      );
      return Astro.redirect(`/capitas/hermano/${resultado.datos.hermano_id}?ok=modalidad`, 303);
    } catch (error) {
      if (!(error instanceof ErrorDeNegocio)) throw error;
      errores = { [error.campo ?? '_general']: error.message };
      valores = { ...valores, ...resultado.valores };
      estado = 422;
    }
  }
}

const [hermanos, faltantes, estados] = await Promise.all([
  hermanosActivos(),
  sinPlan(anio),
  estadosDeCuenta(anio),
]);

const nonce = await emitirNonce(sesion.idHash, 'capita_modalidad');

const idsSinPlan = new Set(faltantes.map((f) => f.id));
const opcionesHermano: Opcion[] = hermanos.map((h) => ({
  valor: String(h.id),
  texto: idsSinPlan.has(h.id) ? `${h.nombre_completo} (sin asignar)` : h.nombre_completo,
  grupo: NOMBRE_GRADO_PLURAL[h.grado],
}));

const opcionesModalidad: Opcion[] = (
  ['mensual', 'promocion', 'prorrateo'] as const
).map((m) => ({ valor: m, texto: NOMBRE_MODALIDAD[m] }));

const opcionesMes: Opcion[] = MESES.map((nombre, i) => ({
  valor: String(i + 1),
  texto: nombre,
}));

Astro.response.status = estado;
---

<LayoutAdmin titulo="Asignar modalidad de cápita" sesion={sesion} angosto>
  <div class="barra__contexto" slot="contexto">
    <span>Ejercicio {anio}</span>
    <span>Mensual: {formatoMXN(ejercicio.capita_mensual_centavos)} al mes</span>
    <span>Anual preferencial: {formatoMXN(ejercicio.capita_promocion_centavos)}</span>
  </div>

  <h1>Asignar modalidad de cápita</h1>

  <div class="tarjeta" style="margin-bottom: 1.25rem;">
    <h2>Las tres modalidades</h2>
    <ul style="margin: 0; font-size: 0.9rem;">
      <li>
        <strong>Mensual</strong>: {formatoMXN(ejercicio.capita_mensual_centavos)} al mes, doce
        meses, {formatoMXN(ejercicio.capita_mensual_centavos * 12)} al año. Para quien viene
        desde enero.
      </li>
      <li>
        <strong>Anual preferencial</strong>: {formatoMXN(ejercicio.capita_promocion_centavos)}
        en un solo pago, a discreción del Venerable Maestro y en cualquier mes del año. Solo
        para quien viene desde enero. Si ya pagó meses, se le descuenta lo pagado.
      </li>
      <li>
        <strong>Prorrateo</strong>: {formatoMXN(ejercicio.capita_mensual_centavos)} por cada
        mes restante, contando desde el mes de iniciación o afiliación. Para quien ingresa
        dentro del año. Es la fecha de ingreso interna: no depende de cuándo lo reconozca
        la Gran Tesorería.
      </li>
    </ul>
    {
      !puedePromocion && (
        <p class="apagado" style="font-size: 0.85rem; margin-bottom: 0;">
          La promoción la habilita el Venerable Maestro, con su propia sesión.
        </p>
      )
    }
  </div>

  <ResumenErrores errores={errores} etiquetas={ETIQUETAS} />

  <Formulario csrf={sesion.csrfToken} nonce={nonce}>
    <Selector
      nombre="hermano_id"
      etiqueta={ETIQUETAS.hermano_id!}
      opciones={opcionesHermano}
      valor={valores.hermano_id}
      error={errores.hermano_id}
      vacio="Elige un hermano"
      requerido
    />

    <Selector
      nombre="modalidad"
      etiqueta={ETIQUETAS.modalidad!}
      opciones={opcionesModalidad}
      valor={valores.modalidad}
      error={errores.modalidad}
      requerido
      ayuda="Si eliges una que no corresponde al mes de ingreso, el sistema lo dirá."
    />

    <Selector
      nombre="mes_promocion"
      etiqueta={ETIQUETAS.mes_promocion!}
      opciones={opcionesMes}
      valor={valores.mes_promocion}
      error={errores.mes_promocion}
      ayuda="Solo aplica a la promoción: el mes en que el V∴M∴ la habilita."
    />

    <Campo
      nombre="motivo"
      etiqueta={ETIQUETAS.motivo!}
      valor={valores.motivo}
      error={errores.motivo}
      ayuda="Queda en la bitácora. Conviene anotarlo cuando se habilita una promoción."
    />

    <div class="formulario__acciones">
      <button class="btn btn--primary" type="submit">Asignar modalidad</button>
      <a class="btn btn--ghost" href="/capitas">Cancelar</a>
    </div>
  </Formulario>

  {
    estados.length > 0 && (
      <section class="tarjeta" style="margin-top: 1.5rem;">
        <h2>Modalidades ya asignadas</h2>
        <div class="tabla-envoltura">
          <table class="tabla">
            <thead>
              <tr>
                <th scope="col">Hermano</th>
                <th scope="col">Modalidad</th>
                <th scope="col" class="num">Esperado</th>
              </tr>
            </thead>
            <tbody>
              {estados.map((e) => (
                <tr>
                  <td>{e.nombre_completo}</td>
                  <td>{e.modalidad ? NOMBRE_MODALIDAD[e.modalidad] : '—'}</td>
                  <td class="num">{formatoMXN(e.esperado_centavos)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</LayoutAdmin>
