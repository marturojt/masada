---
/* Panel de cápitas del ejercicio: quién está al corriente y quién debe. */
import LayoutAdmin from '@layouts/LayoutAdmin.astro';
import Aviso from '@componentes/Aviso.astro';
import { historiaDelPlan } from '@lib/capitas-historia';
import MatrizCapitas from '@componentes/MatrizCapitas.astro';
import {
  NOMBRE_MODALIDAD,
  adeudosDelAnio,
  cargosVencidos,
  estadosDeCuenta,
  planesVigentes,
  resumenCapitas,
  sinPlan,
  textoSituacion,
} from '@lib/datos/capitas';
import { anioDeUrl, ejercicioVigente, listarEjercicios } from '@lib/datos/ejercicios';
import { formatoMXN } from '@lib/dinero';
import { formatoFechaCorta } from '@lib/fechas';
import { avisoDe } from '@lib/formulario';
import { requerirSesion } from '@lib/sesion';

const sesion = requerirSesion(Astro);
const aviso = avisoDe(Astro.url.searchParams.get('ok'));

const ejercicios = await listarEjercicios();
const vigente = await ejercicioVigente();
const anio = anioDeUrl(Astro.url, ejercicios, vigente.anio);

const [adeudos, estados, resumen, faltantes, planes] = await Promise.all([
  adeudosDelAnio(anio),
  estadosDeCuenta(anio),
  resumenCapitas(anio),
  sinPlan(anio),
  planesVigentes(anio),
]);

const mapaPlanes = new Map(planes.map((p) => [p.hermano_id, p]));
const conAdeudo = estados.filter((e) => e.vencido_centavos > 0);
const aFavor = estados.filter((e) => e.saldo_a_favor_centavos > 0);
---

<LayoutAdmin titulo="Cápitas" sesion={sesion}>
  <div class="barra__contexto" slot="contexto">
    <span>Ejercicio {anio}</span>
    <span>Esperado: {formatoMXN(resumen?.esperado ?? 0)}</span>
    <span>Cobrado: {formatoMXN(resumen?.pagado ?? 0)}</span>
    <span>Vencido: {formatoMXN(resumen?.vencido ?? 0)}</span>
    <span>Por vencer: {formatoMXN(resumen?.por_vencer ?? 0)}</span>
    <span>{resumen?.al_corriente ?? 0} al corriente, {resumen?.con_adeudo ?? 0} con adeudo</span>
  </div>

  <Aviso texto={aviso} />

  <div class="encabezado">
    <h1>Cápitas {anio}</h1>
    <div class="fila">
      <a class="btn btn--primary" href="/capitas/pagos/nuevo">Registrar pago</a>
      <a class="btn btn--ghost" href="/capitas/asignar">Asignar modalidad</a>
    </div>
  </div>

  {
    faltantes.length > 0 && (
      <div class="aviso aviso--cuidado">
        <p class="sin-margen">
          {faltantes.length === 1 ? 'Un hermano activo' : `${faltantes.length} hermanos activos`} sin modalidad de cápita asignada para {anio}.
          Mientras no la tengan, no se les puede registrar un pago.
        </p>
        <ul>
          {faltantes.map((h) => (
            <li>
              {h.nombre_completo}
              <span class="apagado"> · ingresó el {formatoFechaCorta(h.fecha_ingreso)}</span>{' '}
              <a href={`/capitas/asignar?hermano=${h.id}`}>asignar</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    estados.length === 0 ? (
      <div class="tarjeta">
        <p class="sin-margen">
          Todavía no hay cápitas asignadas en {anio}. Empieza por
          <a href="/capitas/asignar"> asignar la modalidad</a> de cada hermano.
        </p>
      </div>
    ) : (
      <>
        <MatrizCapitas anio={anio} adeudos={adeudos} estados={estados} planes={mapaPlanes} />

        <section class="tarjeta arriba-xl">
          <h2>Estado por hermano</h2>
          <p class="apagado letra-chica">
            Los totales del ejercicio están en la barra de arriba.
          </p>

          {/* En celular, una tarjeta por hermano en lugar de ocho columnas. */}
          <ul class="tarjetas-hermano solo-celular">
            {estados.map((e) => (
              <li class="tarjeta-hermano">
                <div class="tarjeta-hermano__cab">
                  <a href={`/capitas/hermano/${e.hermano_id}`}>{e.nombre_completo}</a>
                  {e.al_corriente ? (
                    <span class="insignia insignia--ok">Al corriente</span>
                  ) : (
                    <span class="insignia insignia--alerta">
                      {textoSituacion(e.modalidad, e.meses_vencidos)}
                    </span>
                  )}
                </div>
                <p class="tarjeta-hermano__plan">
                  {e.modalidad ? (
                    <span class="insignia insignia--neutro">{NOMBRE_MODALIDAD[e.modalidad]}</span>
                  ) : (
                    <span class="apagado">Sin modalidad</span>
                  )}
                  {e.saldo_a_favor_centavos > 0 && (
                    <span class="insignia insignia--favor">
                      A favor {formatoMXN(e.saldo_a_favor_centavos)}
                    </span>
                  )}
                </p>
                {e.vencido_centavos > 0 && (
                  <p class="tarjeta-hermano__vencido">
                    <span class="apagado">Vencido</span>
                    <span class="cifra-grande">{formatoMXN(e.vencido_centavos)}</span>
                  </p>
                )}
                <p class="apagado letra-menor sin-margen">
                  Esperado {formatoMXN(e.esperado_centavos)} · Pagado{' '}
                  {formatoMXN(e.pagado_centavos)}
                  {e.por_vencer_centavos > 0 && <> · Por vencer {formatoMXN(e.por_vencer_centavos)}</>}
                  {e.condonado_centavos > 0 && <> · Exento {formatoMXN(e.condonado_centavos)}</>}
                </p>
                {e.modalidad && (
                  <details class="historia">
                    <summary>Historia del plan</summary>
                    <p>{historiaDelPlan(mapaPlanes.get(e.hermano_id))}</p>
                  </details>
                )}
              </li>
            ))}
          </ul>

          <div class="tabla-envoltura solo-escritorio">
            <table class="tabla tabla--fija">
              <thead>
                <tr>
                  <th scope="col">Hermano</th>
                  <th scope="col">Modalidad</th>
                  <th scope="col" class="num">Esperado</th>
                  <th scope="col" class="num">Pagado</th>
                  <th scope="col" class="num">Exento</th>
                  <th scope="col" class="num">Vencido</th>
                  <th scope="col" class="num">Por vencer</th>
                  <th scope="col">Situación</th>
                </tr>
              </thead>
              <tbody>
                {estados.map((e) => (
                  <tr>
                    <th scope="row">
                      <a href={`/capitas/hermano/${e.hermano_id}`}>{e.nombre_completo}</a>
                      {e.modalidad && (
                        <details class="historia">
                          <summary>Historia del plan</summary>
                          <p>{historiaDelPlan(mapaPlanes.get(e.hermano_id))}</p>
                        </details>
                      )}
                    </th>
                    <td>
                      {e.modalidad ? (
                        NOMBRE_MODALIDAD[e.modalidad]
                      ) : (
                        <span class="apagado">Sin asignar</span>
                      )}
                    </td>
                    <td class="num">{formatoMXN(e.esperado_centavos)}</td>
                    <td class="num">{formatoMXN(e.pagado_centavos)}</td>
                    <td class="num">
                      {e.condonado_centavos > 0 ? formatoMXN(e.condonado_centavos) : '—'}
                    </td>
                    <td class="num">
                      {e.vencido_centavos > 0 ? formatoMXN(e.vencido_centavos) : '—'}
                    </td>
                    <td class="num">
                      {e.por_vencer_centavos > 0 ? formatoMXN(e.por_vencer_centavos) : '—'}
                    </td>
                    <td>
                      {e.al_corriente ? (
                        <span class="insignia insignia--ok">Al corriente</span>
                      ) : (
                        <span class="insignia insignia--alerta">
                          {textoSituacion(e.modalidad, e.meses_vencidos)}
                        </span>
                      )}
                      {e.saldo_a_favor_centavos > 0 && (
                        <>
                          {' '}
                          <span class="insignia insignia--favor">
                            A favor {formatoMXN(e.saldo_a_favor_centavos)}
                          </span>
                        </>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {conAdeudo.length > 0 && (
          <section class="tarjeta arriba-l">
            <h2>Cartera de adeudos</h2>
            <ul>
              {conAdeudo.map((e) => (
                <li>
                  <a href={`/capitas/hermano/${e.hermano_id}`}>{e.nombre_completo}</a>:{' '}
                  {formatoMXN(e.vencido_centavos)} vencido
                  {e.meses_vencidos > 0 && <> · {cargosVencidos(e.modalidad, e.meses_vencidos)}</>}
                  {e.por_vencer_centavos > 0 && (
                    <span class="apagado"> · más {formatoMXN(e.por_vencer_centavos)} por vencer en el año</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        {aFavor.length > 0 && (
          <section class="tarjeta arriba-l">
            <h2>Saldos a favor</h2>
            <p class="apagado letra-chica">
              Dinero recibido que todavía no cubre ningún mes. No se aplica solo: desde la
              ficha de cada hermano se aplica a sus meses pendientes, se le devuelve o se
              convierte en donativo.
            </p>
            <ul>
              {aFavor.map((e) => (
                <li>
                  <a href={`/capitas/hermano/${e.hermano_id}`}>{e.nombre_completo}</a>:{' '}
                  {formatoMXN(e.saldo_a_favor_centavos)}
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    )
  }
</LayoutAdmin>
