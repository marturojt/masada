---
/*
 * Tablero: lo que un tesorero quiere ver al entrar. Primero cuánto entró y salió
 * en el periodo elegido (el ejercicio o un mes) y de qué conceptos; después lo
 * pendiente: caja, cápitas, Gran Tesorería y egresos que esperan algo.
 *
 * El periodo viaja en la dirección (?anio=2026&periodo=2026-08), sin JavaScript.
 */
import LayoutAdmin from '@layouts/LayoutAdmin.astro';
import Aviso from '@componentes/Aviso.astro';
import GraficaFlujoMensual from '@componentes/graficas/GraficaFlujoMensual.astro';
import GraficaSaldo from '@componentes/graficas/GraficaSaldo.astro';
import { estadoAplomo } from '@lib/datos/gt';
import { pendientesDeEvidencia } from '@lib/datos/pendientes';
import { resumenCapitas, sinPlan } from '@lib/datos/capitas';
import { bolsasAlDia, controlBolsas, cortesDelAnio, primerMesAbierto } from '@lib/datos/cortes';
import { anioDeUrl, ejercicioVigente, listarEjercicios } from '@lib/datos/ejercicios';
import {
  conceptosDelPeriodo,
  periodoDeUrl,
  resumenDelPeriodo,
  type ConceptoPeriodo,
} from '@lib/datos/tablero';
import Selector from '@componentes/Selector.astro';
import { listarEgresos, pendientesDeComprobar } from '@lib/datos/egresos';
import { flujoPorMes, saldoDeCaja } from '@lib/datos/movimientos';
import { formatoMXN } from '@lib/dinero';
import {
  MESES,
  formatoFechaCorta,
  formatoFechaLarga,
  hoyISO,
  nombrePeriodo,
  periodoActual,
} from '@lib/fechas';
import { avisoDe } from '@lib/formulario';
import { requerirSesion } from '@lib/sesion';
import { NOMBRE_ESTADO_EGRESO, CLASE_ESTADO_EGRESO } from '@lib/datos/egresos';
import { cuotasPorCobrar } from '@lib/datos/cuotas';
import { cuenta } from '@lib/texto';

const sesion = requerirSesion(Astro);
const aviso = avisoDe(Astro.url.searchParams.get('ok'));

const ejercicios = await listarEjercicios();
const vigente = await ejercicioVigente();
const anio = anioDeUrl(Astro.url, ejercicios, vigente.anio);
const ejercicio = ejercicios.find((e) => e.anio === anio) ?? vigente;
const periodo = periodoDeUrl(Astro.url, anio);

const [
  caja,
  capitas,
  faltantes,
  pendientes,
  porComprobar,
  cortes,
  mesAbierto,
  flujo,
  aplomo,
  evidencias,
  cuotas,
  control,
  conceptos,
] = await Promise.all([
    saldoDeCaja(anio),
    resumenCapitas(anio),
    sinPlan(anio),
    listarEgresos({ anio, pendientes: true }),
    pendientesDeComprobar(),
    cortesDelAnio(anio),
    primerMesAbierto(anio),
    flujoPorMes(anio),
    estadoAplomo(),
    pendientesDeEvidencia(),
    cuotasPorCobrar(),
    controlBolsas(anio),
    conceptosDelPeriodo(anio, periodo),
  ]);

/* Sección 1: cuánto entró y salió en el periodo. */
const resumen = resumenDelPeriodo(cortes, periodo, periodoActual());
const nombreDelPeriodo = periodo ? nombrePeriodo(periodo) : `todo ${anio}`;
const opcionesPeriodo = [
  { valor: '', texto: `Todo ${anio}` },
  ...MESES.map((m, i) => ({ valor: `${anio}-${String(i + 1).padStart(2, '0')}`, texto: m })),
];

/* Diferencia contra el mes anterior, con signo y en palabras. */
const contraAnterior = (actual: number, previo: number): string => {
  const dif = actual - previo;
  if (dif === 0) return 'igual que';
  return `${dif > 0 ? '+' : '−'}${formatoMXN(Math.abs(dif))} vs`;
};

/* Sección 2: de dónde vino y a dónde se fue, con su parte del total. */
const reparto = (tipo: 'ingreso' | 'egreso') => {
  const filas = conceptos.filter((c) => c.tipo === tipo);
  const total = filas.reduce((s, c) => s + c.monto_centavos, 0);
  return filas.map((c: ConceptoPeriodo) => ({
    ...c,
    porcentaje: total > 0 ? (c.monto_centavos / total) * 100 : 0,
  }));
};
const repartoIngresos = reparto('ingreso');
const repartoEgresos = reparto('egreso');
const enlaceConcepto = (c: ConceptoPeriodo) =>
  `/movimientos?anio=${anio}${periodo ? `&periodo=${periodo}` : ''}&concepto=${c.concepto_id}`;
const formatoPorcentaje = (p: number) =>
  p > 0 && p < 1 ? 'menos de 1%' : `${Math.round(p)}%`;

/* Hasta el arqueo inicial, el desglose banco y efectivo no es confiable. */
const conBolsas = bolsasAlDia(control);

const porCobrarCuotas = cuotas.reduce((s, c) => s + c.saldo_centavos, 0);

/* La barra de avance de cápitas: cobrado, vencido y lo que falta del año. */
const capEsperado = Math.max(1, capitas?.esperado ?? 0);
const avance = {
  cobrado: ((capitas?.pagado ?? 0) / capEsperado) * 100,
  vencido: ((capitas?.vencido ?? 0) / capEsperado) * 100,
  porVencer: ((capitas?.por_vencer ?? 0) / capEsperado) * 100,
};

const porFirmar = pendientes.filter((e) => e.estado === 'registrado');
const porEntregar = pendientes.filter((e) => e.estado === 'autorizado');

const cerrados = cortes.filter((c) => c.estado_corte === 'cerrado').length;
const mesEnCurso = periodoActual();
/* El mes que toca cerrar es el abierto más antiguo, si ya terminó. */
const mesAtrasado = mesAbierto !== null && mesAbierto < mesEnCurso ? mesAbierto : null;

const sinApertura = ejercicio.saldo_apertura_centavos === 0 && caja.ingresos === 0;
---

<LayoutAdmin titulo="Tablero" sesion={sesion}>
  <div class="barra__contexto" slot="contexto">
    <span>Hoy es {formatoFechaLarga(hoyISO())}</span>
    <span>Ejercicio {anio}</span>
    {conBolsas && <span>Banco: {formatoMXN(caja.banco)}</span>}
    {conBolsas && <span>Efectivo: {formatoMXN(caja.efectivo)}</span>}
    <span>Total: {formatoMXN(caja.saldo)}</span>
  </div>

  <Aviso texto={aviso} />

  <h1>Tesorería</h1>

  {
    sinApertura && (
      <div class="aviso aviso--error">
        Falta capturar el <strong>saldo de apertura</strong> de {anio} en{' '}
        <a href="/herramientas">Herramientas</a>. De esa cifra se encadenan todos los
        saldos de los cortes.
      </div>
    )
  }

  {
    faltantes.length > 0 && (
      <div class="aviso aviso--cuidado">
        {faltantes.length === 1 ? 'Un hermano' : `${faltantes.length} hermanos`} sin modalidad de cápita para {anio}:{' '}
        {faltantes
          .slice(0, 4)
          .map((h) => h.nombre_completo)
          .join(', ')}
        {faltantes.length > 4 && ` y ${faltantes.length - 4} más`}.{' '}
        <a href="/capitas/asignar">Asignar</a>
      </div>
    )
  }

  {
    mesAtrasado && (
      <div class="aviso aviso--cuidado">
        El corte de <strong>{nombrePeriodo(mesAtrasado)}</strong> sigue abierto.{' '}
        <a href={`/cortes/${mesAtrasado}`}>Revisar y cerrar</a>
      </div>
    )
  }

  <div class="pila arriba-l">
    <section class="tarjeta">
      <form method="get" class="filtros" aria-label="Periodo del tablero">
        {
          ejercicios.length > 1 ? (
            <Selector
              nombre="anio"
              etiqueta="Ejercicio"
              opciones={ejercicios.map((e) => ({ valor: String(e.anio), texto: String(e.anio) }))}
              valor={String(anio)}
            />
          ) : (
            <input type="hidden" name="anio" value={String(anio)} />
          )
        }
        <Selector nombre="periodo" etiqueta="Periodo" opciones={opcionesPeriodo} valor={periodo ?? ''} />
        <div class="filtros__acciones">
          <button class="btn btn--primary" type="submit">Ver</button>
          {periodo && <a class="btn btn--ghost" href={`/?anio=${anio}`}>Todo el año</a>}
        </div>
      </form>
    </section>

    {/*
      Tres niveles: bloque (h2 grande con línea), tarjeta (etiqueta en versalitas) y
      cifra grande. Entre bloques hay más aire que entre tarjetas.
    */}
    <section class="bloque" aria-labelledby="titulo-periodo">
      <h2 class="bloque__titulo" id="titulo-periodo">
        Este periodo: {periodo ? nombrePeriodo(periodo) : `ejercicio ${anio}`}
      </h2>
      <div class="cifras-periodo">
        <div class="tarjeta tarjeta--cifra">
          <p class="tarjeta__etiqueta">Ingresos</p>
          <p class="cifra-grande cifras-periodo__valor--ingreso">{formatoMXN(resumen.ingresos)}</p>
          <p class="nota-cifra">
            {resumen.anterior
              ? `${contraAnterior(resumen.ingresos, resumen.anterior.ingresos)} ${nombrePeriodo(resumen.anterior.periodo).split(' ')[0]}`
              : <a href={`/movimientos?anio=${anio}${periodo ? `&periodo=${periodo}` : ''}&tipo=ingreso`}>Ver movimientos</a>}
          </p>
        </div>
        <div class="tarjeta tarjeta--cifra">
          <p class="tarjeta__etiqueta">Egresos</p>
          <p class="cifra-grande cifras-periodo__valor--egreso">{formatoMXN(resumen.egresos)}</p>
          <p class="nota-cifra">
            {resumen.anterior
              ? `${contraAnterior(resumen.egresos, resumen.anterior.egresos)} ${nombrePeriodo(resumen.anterior.periodo).split(' ')[0]}`
              : <a href={`/movimientos?anio=${anio}${periodo ? `&periodo=${periodo}` : ''}&tipo=egreso`}>Ver movimientos</a>}
          </p>
        </div>
        <div class="tarjeta tarjeta--cifra">
          <p class="tarjeta__etiqueta">Resultado</p>
          <p class:list={['cifra-grande', { 'cifras-periodo__valor--negativo': resumen.resultado < 0 }]}>
            {resumen.resultado < 0 ? '−' : ''}{formatoMXN(Math.abs(resumen.resultado))}
          </p>
          <p class="nota-cifra">
            {resumen.resultado > 0
              ? 'Entró más de lo que salió'
              : resumen.resultado < 0
                ? 'Salió más de lo que entró'
                : 'Entró lo mismo que salió'}
          </p>
        </div>
        <div class="tarjeta tarjeta--cifra">
          <p class="tarjeta__etiqueta">{resumen.etiquetaSaldo}</p>
          <p class="cifra-grande">{formatoMXN(resumen.saldoFinal)}</p>
          <p class="nota-cifra">
            {periodo ? <a href={`/cortes/${periodo}`}>Ver el corte</a> : <a href="/cortes">Ver los cortes</a>}
          </p>
        </div>
      </div>

      <div class="rejilla">
        {
          (
            [
              ['ingreso', 'De dónde vino', repartoIngresos, 'Sin ingresos'],
              ['egreso', 'A dónde se fue', repartoEgresos, 'Sin egresos'],
            ] as const
          ).map(([tipo, titulo, filas, vacio]) => (
            <section class="tarjeta">
              <h3 class="tarjeta__etiqueta">{titulo}</h3>
              {filas.length === 0 ? (
                <p class="apagado sin-margen">{vacio} en {nombreDelPeriodo}.</p>
              ) : (
                <ul class="reparto">
                  {filas.map((c) => (
                    <li class="reparto__fila">
                      <a class="reparto__nombre" href={enlaceConcepto(c)}>{c.concepto_nombre}</a>
                      <span class="reparto__monto">
                        {formatoMXN(c.monto_centavos)}{' '}
                        <span class="reparto__detalle">{formatoPorcentaje(c.porcentaje)}</span>
                      </span>
                      <span class="reparto__pista" aria-hidden="true">
                        <span
                          class:list={['reparto__barra', `reparto__barra--${tipo}`]}
                          style={`width: ${Math.max(c.porcentaje, 0.5)}%;`}
                        ></span>
                      </span>
                      <span class="reparto__detalle">
                        {c.movimientos} {c.movimientos === 1 ? 'movimiento' : 'movimientos'}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      <div class="rejilla rejilla--ancha">
        <section class="tarjeta">
          <GraficaFlujoMensual flujo={flujo} anio={anio} seleccionado={periodo} />
        </section>
        <section class="tarjeta">
          <GraficaSaldo flujo={flujo} apertura={caja.apertura} anio={anio} />
        </section>
      </div>
    </section>

    <section class="bloque" aria-labelledby="titulo-pendientes">
      <h2 class="bloque__titulo" id="titulo-pendientes">Pendientes</h2>
      {/* Todas con la misma forma: etiqueta, número, una línea de contexto y Ver. */}
      <div class="rejilla rejilla--pendientes">
        <section class="tarjeta tarjeta--pendiente">
          <h3 class="tarjeta__etiqueta">Caja</h3>
          <p class="cifra-grande">{formatoMXN(caja.saldo)}</p>
          <p class="nota-cifra">
            {conBolsas ? (
              <>Banco {formatoMXN(caja.banco)} · Efectivo {formatoMXN(caja.efectivo)}</>
            ) : control.desde ? (
              <>Banco y efectivo: falta el arqueo inicial</>
            ) : (
              <>Dinero de la logia hoy</>
            )}
          </p>
          <a class="tarjeta__ver" href={!conBolsas && control.desde ? `/cortes/${control.desde}#arqueo` : '/movimientos'}>Ver</a>
        </section>

        <section class="tarjeta tarjeta--pendiente">
          <h3 class="tarjeta__etiqueta">Cápitas vencidas</h3>
          <p class="cifra-grande">{formatoMXN(capitas?.vencido ?? 0)}</p>
          <p class="nota-cifra">
            {cuenta(capitas?.con_adeudo ?? 0, 'hermano con adeudo', 'hermanos con adeudo')}
          </p>
          <a class="tarjeta__ver" href="/capitas">Ver</a>
        </section>

        <section class="tarjeta tarjeta--pendiente">
          <h3 class="tarjeta__etiqueta">Gran Tesorería</h3>
          <p class="cifra-grande">
            {aplomo.ordinario_a_plomo ? 0 : aplomo.meses_pendientes}{' '}
            <span class="cifra-grande__unidad">
              {(aplomo.ordinario_a_plomo ? 0 : aplomo.meses_pendientes) === 1 ? 'mes' : 'meses'}
            </span>
          </p>
          <p class="nota-cifra">
            {aplomo.ordinario_a_plomo ? (
              <span class="insignia insignia--ok">A plomo</span>
            ) : (
              <span class="insignia insignia--alerta">Atrasado</span>
            )}{' '}
            {!aplomo.ordinario_a_plomo && 'por pagar. '}
            {aplomo.cubierto_hasta
              ? `Cubierto hasta ${nombrePeriodo(aplomo.cubierto_hasta.slice(0, 7))}`
              : 'Sin obligaciones pagadas'}
          </p>
          <a class="tarjeta__ver" href="/gran-tesoreria">Ver</a>
        </section>

        <section class="tarjeta tarjeta--pendiente">
          <h3 class="tarjeta__etiqueta">Evidencias</h3>
          <p class="cifra-grande">{evidencias.length}</p>
          <p class="nota-cifra">
            {evidencias.length === 1 ? 'Documento por adjuntar' : 'Documentos por adjuntar'}
          </p>
          <a class="tarjeta__ver" href="/pendientes">Ver</a>
        </section>

        <section class="tarjeta tarjeta--pendiente">
          <h3 class="tarjeta__etiqueta">Cuotas de grado</h3>
          <p class="cifra-grande">{formatoMXN(porCobrarCuotas)}</p>
          <p class="nota-cifra">
            Por cobrar a {cuenta(new Set(cuotas.map((c) => c.hermano_id)).size, 'persona', 'personas')}
          </p>
          <a class="tarjeta__ver" href="/hermanos#cuotas">Ver</a>
        </section>

        <section class="tarjeta tarjeta--pendiente">
          <h3 class="tarjeta__etiqueta">Cortes</h3>
          <p class="cifra-grande">
            {cerrados} <span class="cifra-grande__unidad">de 12 cerrados</span>
          </p>
          <p class="nota-cifra">
            {mesAbierto ? `Sigue ${nombrePeriodo(mesAbierto)}` : 'Ejercicio completo'}
          </p>
          <a class="tarjeta__ver" href={mesAbierto ? `/cortes/${mesAbierto}` : '/cortes'}>Ver</a>
        </section>
      </div>

    {
      (porFirmar.length > 0 || porEntregar.length > 0 || porComprobar.length > 0) && (
        <section class="tarjeta">
          <h3 class="tarjeta__etiqueta">Egresos que esperan algo</h3>
          <div class="tabla-envoltura">
            <table class="tabla">
              <thead>
                <tr>
                  <th scope="col">Folio</th>
                  <th scope="col">Beneficiario</th>
                  <th scope="col" class="num">Monto</th>
                  <th scope="col">Estado</th>
                  <th scope="col">Qué falta</th>
                </tr>
              </thead>
              <tbody>
                {porFirmar.map((e) => (
                  <tr>
                    <td><a href={`/egresos/${e.id}`}>{e.folio}</a></td>
                    <td>{e.beneficiario}</td>
                    <td class="num">{formatoMXN(e.monto_solicitado_centavos)}</td>
                    <td><span class:list={['insignia', CLASE_ESTADO_EGRESO[e.estado]]}>{NOMBRE_ESTADO_EGRESO[e.estado]}</span></td>
                    <td>
                      {!e.firmo_tesorero && !e.firmo_vm
                        ? 'Las dos firmas, del tesorero y del V∴M∴'
                        : !e.firmo_vm
                          ? 'La firma del V∴M∴'
                          : 'La firma del tesorero'}
                    </td>
                  </tr>
                ))}
                {porEntregar.map((e) => (
                  <tr>
                    <td><a href={`/egresos/${e.id}`}>{e.folio}</a></td>
                    <td>{e.beneficiario}</td>
                    <td class="num">{formatoMXN(e.monto_autorizado_centavos ?? e.monto_solicitado_centavos)}</td>
                    <td><span class:list={['insignia', CLASE_ESTADO_EGRESO[e.estado]]}>{NOMBRE_ESTADO_EGRESO[e.estado]}</span></td>
                    <td>Registrar la entrega</td>
                  </tr>
                ))}
                {porComprobar.map((p) => (
                  <tr>
                    <td><a href={`/egresos/${p.id}`}>{p.folio}</a></td>
                    <td>{p.beneficiario}</td>
                    <td class="num">{formatoMXN(p.pendiente_centavos)}</td>
                    <td><span class="insignia insignia--alerta">Por comprobar</span></td>
                    <td>Recibos o devolución, entregado el {formatoFechaCorta(p.fecha_entrega)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    </section>

    <section class="bloque" aria-labelledby="titulo-avance">
      <h2 class="bloque__titulo" id="titulo-avance">Avance de cápitas {anio}</h2>
      <section class="tarjeta">
        <div class="avance" role="img" aria-label={`Cobrado ${formatoMXN(capitas?.pagado ?? 0)}, vencido ${formatoMXN(capitas?.vencido ?? 0)}, por vencer ${formatoMXN(capitas?.por_vencer ?? 0)}`}>
          {avance.cobrado > 0 && <span class="avance__cobrado" style={`width: ${avance.cobrado}%;`}></span>}
          {avance.vencido > 0 && <span class="avance__vencido" style={`width: ${avance.vencido}%;`}></span>}
          {avance.porVencer > 0 && <span class="avance__porvencer" style={`width: ${avance.porVencer}%;`}></span>}
        </div>
        <dl class="leyenda-avance">
          <div>
            <dt><span class="grafica__muestra avance__cobrado"></span>Cobrado</dt>
            <dd>{formatoMXN(capitas?.pagado ?? 0)}</dd>
          </div>
          <div>
            <dt><span class="grafica__muestra avance__vencido"></span>Vencido</dt>
            <dd>{formatoMXN(capitas?.vencido ?? 0)}</dd>
          </div>
          <div>
            <dt><span class="grafica__muestra avance__porvencer"></span>Por vencer</dt>
            <dd>{formatoMXN(capitas?.por_vencer ?? 0)}</dd>
          </div>
          <div>
            <dt>Esperado del año</dt>
            <dd>{formatoMXN(capitas?.esperado ?? 0)}</dd>
          </div>
        </dl>
        <p class="nota-cifra">
          <span class="insignia insignia--ok">{capitas?.al_corriente ?? 0} al corriente</span>{' '}
          <a href="/capitas">Ver cápitas</a>
        </p>
      </section>
    </section>

    <section class="tarjeta">
      <h2>Capturar</h2>
      <div class="fila">
        <a class="btn btn--primary" href="/capitas/pagos/nuevo">Pago de cápita</a>
        <a class="btn btn--ghost" href="/ingresos/nuevo">Otro ingreso</a>
        <a class="btn btn--ghost" href="/egresos/nuevo">Egreso</a>
        <a class="btn btn--ghost" href="/gran-tesoreria">Gran Tesorería</a>
      </div>
    </section>
  </div>
</LayoutAdmin>
