---
/*
 * Ficha de una membresía: el documento que mandó la Gran Tesorería, para
 * consultarlo. Es respaldo de lo que GT entiende de Masada en esa fecha: no se
 * concilia ni se gestiona desde aquí. Una registrada por error se elimina.
 */
import LayoutAdmin from '@layouts/LayoutAdmin.astro';
import Aviso from '@componentes/Aviso.astro';
import VisorImagen from '@componentes/VisorImagen.astro';
import Campo from '@componentes/Campo.astro';
import Confirmacion from '@componentes/Confirmacion.astro';
import Formulario from '@componentes/Formulario.astro';
import ResumenErrores from '@componentes/ResumenErrores.astro';
import { eliminarMembresia } from '@lib/casos/gt';
import { emitirNonce } from '@lib/csrf';
import { obtenerMembresia, renglonesDeMembresia } from '@lib/datos/gt';
import { ErrorDeNegocio } from '@lib/errores';
import { esquemaMotivo } from '@lib/esquemas/egreso';
import { formatoFechaCorta, nombrePeriodo } from '@lib/fechas';
import { avisoDe, leerFormulario, validar } from '@lib/formulario';
import { sonImagenes } from '@lib/archivos';
import { esVM, requerirSesion } from '@lib/sesion';

const sesion = requerirSesion(Astro);
const aviso = avisoDe(Astro.url.searchParams.get('ok'));
const soyVM = esVM(sesion);

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return new Response('No encontrado', { status: 404 });

let errores: Record<string, string> = {};
let estado = 200;

if (Astro.request.method === 'POST') {
  const entrada = await leerFormulario(Astro);
  if (!entrada.ok) {
    errores = entrada.errores;
    estado = entrada.estado;
  } else if (entrada.accion === 'eliminar') {
    const r = await validar(entrada, {
      esquema: esquemaMotivo,
      proposito: 'gt_membresia_eliminar',
      sesion,
    });
    if (!r.ok) {
      errores = r.errores;
      estado = r.estado;
    } else {
      try {
        await eliminarMembresia(
          { sesion, nonce: r.nonce, idPeticion: Astro.locals.idPeticion },
          id,
          r.datos.motivo,
        );
        return Astro.redirect('/gran-tesoreria/membresias?ok=membresia_eliminada', 303);
      } catch (error) {
        if (!(error instanceof ErrorDeNegocio)) throw error;
        errores = { [error.campo ?? '_general']: error.message };
        estado = 422;
      }
    }
  } else {
    errores = { _general: 'Acción no reconocida.' };
    estado = 400;
  }
}

const membresia = await obtenerMembresia(id);
if (!membresia) return new Response('No encontrado', { status: 404 });

/* Los renglones ya no se capturan; los que haya de antes se muestran. */
const renglones = await renglonesDeMembresia(id);
const imagenes = membresia.archivo_id
  ? await sonImagenes([membresia.archivo_id])
  : new Map<number, boolean>();
const nonceEliminar = soyVM ? await emitirNonce(sesion.idHash, 'gt_membresia_eliminar') : '';

Astro.response.status = estado;
---

<LayoutAdmin titulo={`Membresía ${nombrePeriodo(membresia.periodo_referencia.slice(0, 7))}`} sesion={sesion}>
  <div class="barra__contexto" slot="contexto">
    <span><a href="/gran-tesoreria/membresias">← Membresías</a></span>
    <span>Documento del {formatoFechaCorta(membresia.fecha_documento)}</span>
  </div>

  <Aviso texto={aviso} />
  <ResumenErrores errores={errores} />

  <h1>Membresía de {nombrePeriodo(membresia.periodo_referencia.slice(0, 7))}</h1>

  <div class="pila" style="margin-top: 1.25rem;">
    <section class="tarjeta">
      <h2>Documento</h2>
      <div class="tabla-envoltura">
        <table class="tabla">
          <tbody>
            <tr>
              <th scope="row">Fecha del documento</th>
              <td>{formatoFechaCorta(membresia.fecha_documento)}</td>
            </tr>
            {membresia.fecha_recepcion && (
              <tr>
                <th scope="row">Recibido el</th>
                <td>{formatoFechaCorta(membresia.fecha_recepcion)}</td>
              </tr>
            )}
            <tr>
              <th scope="row">Archivo</th>
              <td>
                {membresia.archivo_id ? (
                  <VisorImagen
                    archivoId={membresia.archivo_id}
                    texto="Ver documento"
                    esImagen={imagenes.get(membresia.archivo_id) ?? false}
                  />
                ) : (
                  <span class="apagado">Sin documento adjunto</span>
                )}
              </td>
            </tr>
            {membresia.observaciones && (
              <tr>
                <th scope="row">Observaciones</th>
                <td style="white-space: pre-line;">{membresia.observaciones}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </section>

    {
      renglones.length > 0 && (
        <section class="tarjeta">
          <h2>Hermanos reportados</h2>
          <p class="apagado" style="font-size: 0.85rem;">
            Capturados cuando la membresía se llevaba renglón por renglón. Se conservan para
            consulta; ya no se agregan.
          </p>
          <div class="tabla-envoltura">
            <table class="tabla">
              <thead>
                <tr>
                  <th>Nombre reportado</th>
                  <th>Clave</th>
                  <th>Grado</th>
                  <th>Estatus</th>
                  <th>Cápita</th>
                </tr>
              </thead>
              <tbody>
                {renglones.map((r) => (
                  <tr>
                    <td>{r.nombre_reportado}</td>
                    <td>{r.clave_mason_reportada ?? ''}</td>
                    <td>{r.grado_reportado ?? ''}</td>
                    <td>{r.estatus_reportado ?? ''}</td>
                    <td>{r.genera_capita ? 'Sí' : 'No'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      soyVM && (
        <section class="tarjeta">
          <details open={errores.motivo !== undefined || errores.confirmo !== undefined}>
            <summary style="cursor: pointer;">Eliminar esta membresía</summary>
            <div style="margin-top: 0.75rem; max-width: 26rem;">
              <p class="apagado" style="font-size: 0.85rem;">
                Solo si se registró por error, por ejemplo dos veces. Es un documento de
                consulta: no afecta cuentas ni obligaciones. Queda en la bitácora con su motivo.
              </p>
              <Formulario csrf={sesion.csrfToken} nonce={nonceEliminar} accionInterna="eliminar">
                <Campo
                  nombre="motivo"
                  etiqueta="Motivo"
                  error={errores.motivo}
                  marcador="Registrada dos veces"
                  requerido
                />
                <Confirmacion texto="Entiendo que la membresía se borra y no se puede recuperar." error={errores.confirmo} />
                <button class="btn btn--ghost" type="submit">Eliminar membresía</button>
              </Formulario>
            </div>
          </details>
        </section>
      )
    }
  </div>
</LayoutAdmin>
