---
/*
 * Trámite ante la Gran Tesorería, como pasa en la vida real: el tesorero va,
 * pregunta cuánto cuesta, y lo paga. Una fecha de solicitud, un hermano, una
 * clase (la iniciación da aprendiz, el aumento compañero, la exaltación
 * maestro) o un trámite administrativo con su nombre. Por dentro es una
 * obligación GT de tipo trámite, así que su pago viaja igual: egreso con dos
 * firmas y entrega con comprobante.
 */
import LayoutAdmin from '@layouts/LayoutAdmin.astro';
import Campo from '@componentes/Campo.astro';
import Formulario from '@componentes/Formulario.astro';
import ResumenErrores from '@componentes/ResumenErrores.astro';
import Selector from '@componentes/Selector.astro';
import { capturarObligacion } from '@lib/casos/gt';
import { emitirNonce } from '@lib/csrf';
import { NOMBRE_CLASE_TRAMITE, estadoAplomo, tarifasGTVigentes } from '@lib/datos/gt';
import { formatoMXN } from '@lib/dinero';
import { personasParaCobro } from '@lib/datos/hermanos';
import { ErrorDeNegocio } from '@lib/errores';
import { esquemaTramite } from '@lib/esquemas/gt';
import { formatoFechaCorta, hoyISO, nombrePeriodo } from '@lib/fechas';
import { procesarFormulario } from '@lib/formulario';
import { requerirSesion } from '@lib/sesion';
import { NOMBRE_GRADO_PLURAL, type Opcion } from '@lib/tipos';

const sesion = requerirSesion(Astro);

const ETIQUETAS: Record<string, string> = {
  hermano_id: 'Hermano',
  tramite_clase: 'Qué trámite es',
  tramite_descripcion: 'Nombre del trámite',
  cubre_desde: 'Cubre desde',
  cubre_hasta: 'Cubre hasta',
  fecha_solicitud: 'Fecha de solicitud',
  monto_reportado: 'Lo que cobró la Gran Tesorería',
  calculo: 'Documento o nota de la GT',
  observaciones: 'Observaciones',
};

const [hermanos, aplomo, tarifas] = await Promise.all([
  /* Por un candidato se aparta fecha antes de su ceremonia. */
  personasParaCobro(),
  estadoAplomo(),
  tarifasGTVigentes(),
]);

/* Lo que la ley cobra por trámite, a la vista para comparar con lo que pidió la GT. */
const tarifasTramite = tarifas.filter((t) =>
  ['movimientos', 'regularizacion', 'reconocimientos'].includes(t.grupo),
);
const desdeLey = tarifasTramite[0]?.vigencia_desde ?? null;

let errores: Record<string, string> = {};
let valores: Record<string, string> = {
  fecha_solicitud: hoyISO(),
  tramite_clase: 'afiliacion',
};
let estado = 200;

if (Astro.request.method === 'POST') {
  const resultado = await procesarFormulario(Astro, {
    esquema: esquemaTramite,
    proposito: 'gt_obligacion',
    sesion,
  });
  if (!resultado.ok) {
    errores = resultado.errores;
    valores = { ...valores, ...resultado.valores };
    estado = resultado.estado;
  } else {
    try {
      /*
       * Un trámite no ampara meses: su periodo es el mes de la solicitud. El
       * ajuste de cápitas es la excepción: su periodo son los meses que cubre.
       */
      const datos = resultado.datos;
      const periodo = datos.fecha_solicitud.slice(0, 7);
      const esAjuste = datos.tramite_clase === 'ajuste_capitas';
      if (esAjuste && (!datos.cubre_desde || !datos.cubre_hasta)) {
        throw new ErrorDeNegocio(
          'Indica los meses que cubre el ajuste, como vienen en el recibo (por ejemplo, dic 2025 a oct 2026).',
          datos.cubre_desde ? 'cubre_hasta' : 'cubre_desde',
        );
      }
      const creada = await capturarObligacion(
        { sesion, nonce: resultado.nonce, idPeticion: Astro.locals.idPeticion },
        {
          tipo: 'tramite',
          periodo_desde: esAjuste ? datos.cubre_desde! : periodo,
          periodo_hasta: esAjuste ? datos.cubre_hasta! : periodo,
          fecha_documento: resultado.datos.fecha_solicitud,
          monto_reportado: resultado.datos.monto_reportado,
          hermano_id: resultado.datos.hermano_id,
          observaciones: resultado.datos.observaciones,
          tramite_clase: resultado.datos.tramite_clase,
          tramite_descripcion: resultado.datos.tramite_descripcion,
        },
        resultado.archivos.calculo,
      );
      return Astro.redirect(`/gran-tesoreria/obligaciones/${creada.id}?ok=obligacion`, 303);
    } catch (error) {
      if (!(error instanceof ErrorDeNegocio)) throw error;
      errores = { [error.campo ?? '_general']: error.message };
      valores = { ...valores, ...resultado.valores };
      estado = 422;
    }
  }
}

const nonce = await emitirNonce(sesion.idHash, 'gt_obligacion');

const opcionesHermano: Opcion[] = hermanos.map((h) => ({
  valor: String(h.id),
  texto: h.nombre_completo,
  grupo: h.grado ? NOMBRE_GRADO_PLURAL[h.grado] : 'Candidatos',
}));
const opcionesClase: Opcion[] = Object.entries(NOMBRE_CLASE_TRAMITE).map(([valor, texto]) => ({
  valor,
  texto,
}));

Astro.response.status = estado;
---

<LayoutAdmin titulo="Capturar trámite" sesion={sesion} angosto>
  <div class="barra__contexto" slot="contexto">
    <span><a href="/gran-tesoreria">← Gran Tesorería</a></span>
  </div>

  <h1>Capturar trámite</h1>
  <p class="apagado">
    Como pasa en la ventanilla: se pregunta el costo y se paga en el momento. Aquí se
    captura lo que la Gran Tesorería cobró; el pago sale después como egreso con sus dos
    firmas y su comprobante, desde la ficha del trámite.
  </p>

  {
    !aplomo.ordinario_a_plomo && (
      <div class="aviso aviso--error">
        Aviso: la logia no está a plomo en lo ordinario
        {aplomo.primer_pendiente && (
          <> (pendiente desde {nombrePeriodo(aplomo.primer_pendiente.slice(0, 7))})</>
        )}
        . Los trámites suelen requerir estar a plomo; el sistema avisa pero no lo impide,
        la palabra final la tiene la Gran Tesorería.
      </div>
    )
  }

  <ResumenErrores errores={errores} etiquetas={ETIQUETAS} />

  <Formulario csrf={sesion.csrfToken} nonce={nonce} archivos>
    <Selector
      nombre="hermano_id"
      etiqueta={ETIQUETAS.hermano_id!}
      opciones={opcionesHermano}
      valor={valores.hermano_id}
      error={errores.hermano_id}
      requerido
    />
    <Selector
      nombre="tramite_clase"
      etiqueta={ETIQUETAS.tramite_clase!}
      opciones={opcionesClase}
      valor={valores.tramite_clase}
      error={errores.tramite_clase}
      requerido
    />
    <Campo
      nombre="tramite_descripcion"
      etiqueta={ETIQUETAS.tramite_descripcion!}
      valor={valores.tramite_descripcion}
      error={errores.tramite_descripcion}
      ayuda='Obligatorio si es "Otro trámite administrativo": por ejemplo, Carta de regularidad para grados filosóficos.'
    />
    <fieldset class="campo" style="border: 0; padding: 0; margin: 0 0 1rem;">
      <legend class="campo__etiqueta">Meses que cubre (solo ajuste de cápitas)</legend>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <Campo
          nombre="cubre_desde"
          etiqueta={ETIQUETAS.cubre_desde!}
          tipo="month"
          valor={valores.cubre_desde}
          error={errores.cubre_desde}
        />
        <Campo
          nombre="cubre_hasta"
          etiqueta={ETIQUETAS.cubre_hasta!}
          tipo="month"
          valor={valores.cubre_hasta}
          error={errores.cubre_hasta}
        />
      </div>
      <span class="campo__ayuda">
        Los meses que la Gran Tesorería cobró para respetar la fecha de iniciación del
        hermano, como dice el recibo. Los demás trámites no amparan meses.
      </span>
    </fieldset>
    <Campo
      nombre="fecha_solicitud"
      etiqueta={ETIQUETAS.fecha_solicitud!}
      valor={valores.fecha_solicitud}
      error={errores.fecha_solicitud}
      marcador="AAAA-MM-DD"
      requerido
      ayuda="El día que se pidió y cobró en la Gran Tesorería. También vale 06/04/2026."
    />
    <Campo
      nombre="monto_reportado"
      etiqueta={ETIQUETAS.monto_reportado!}
      valor={valores.monto_reportado}
      error={errores.monto_reportado}
      modoTeclado="decimal"
      monto
      requerido
      ayuda="Lo que cobró en la ventanilla. La tabla de abajo trae los montos de la ley como referencia."
    />
    {
      tarifasTramite.length > 0 && (
        <details style="margin-bottom: 1rem;">
          <summary style="cursor: pointer;">Montos de la Ley de Ingresos</summary>
          <table class="tabla" style="margin-top: 0.5rem; font-size: 0.85rem;">
            <tbody>
              {tarifasTramite.map((t) => (
                <tr>
                  <td>{t.nombre}</td>
                  <td class="num">{formatoMXN(t.monto_centavos)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {desdeLey && (
            <p class="apagado" style="font-size: 0.8rem;">
              Vigentes desde el {formatoFechaCorta(desdeLey)}. Para un trámite anterior, los
              montos de entonces están en el <a href="/gran-tesoreria/tarifas">historial de tarifas</a>.
            </p>
          )}
        </details>
      )
    }
    <Campo
      nombre="calculo"
      etiqueta={ETIQUETAS.calculo!}
      tipo="file"
      error={errores.calculo}
      aceptar="image/jpeg,image/png,image/webp,image/heic,application/pdf"
      ayuda="Si la GT entregó nota o documento del cobro."
    />
    <Campo
      nombre="observaciones"
      etiqueta={ETIQUETAS.observaciones!}
      valor={valores.observaciones}
      error={errores.observaciones}
      largo
      filas={2}
    />
    <div class="formulario__acciones">
      <button class="btn btn--primary" type="submit">Capturar trámite</button>
      <a class="btn btn--ghost" href="/gran-tesoreria">Cancelar</a>
    </div>
  </Formulario>
</LayoutAdmin>
