---
/*
 * Barras agrupadas de ingresos y egresos por mes. SVG dibujado en el servidor,
 * sin JavaScript: el detalle de cada barra sale con el tooltip nativo (title).
 * Paleta validada sobre la superficie oscura: oro para ingresos, azul para
 * egresos, con separación suficiente también para daltonismo.
 *
 * Con `anio`, cada mes es un enlace que filtra el tablero a ese mes, y el mes
 * elegido se resalta. Las cifras exactas van en una tabla desplegable.
 */
import type { FlujoMes } from '@lib/datos/movimientos';
import { formatoMXN } from '@lib/dinero';
import { MESES, MESES_CORTOS } from '@lib/fechas';

interface Props {
  flujo: FlujoMes[];
  /** Ejercicio de la gráfica: activa los enlaces por mes. */
  anio?: number;
  /** Mes elegido, AAAA-MM, para resaltarlo. */
  seleccionado?: string | null;
}

const { flujo, anio, seleccionado = null } = Astro.props;

const periodoDe = (mes: number) => `${anio}-${String(mes).padStart(2, '0')}`;
const enlaceDe = (mes: number) =>
  periodoDe(mes) === seleccionado ? `/?anio=${anio}` : `/?anio=${anio}&periodo=${periodoDe(mes)}`;

const ANCHO = 680;
const ALTO = 230;
const MARGEN = { arriba: 12, abajo: 26, izquierda: 56, derecha: 8 };
const zona = {
  w: ANCHO - MARGEN.izquierda - MARGEN.derecha,
  h: ALTO - MARGEN.arriba - MARGEN.abajo,
};

const maximo = Math.max(1, ...flujo.flatMap((f) => [f.ingresos, f.egresos]));
/* Techo redondo del eje: el múltiplo de 5,000 o 10,000 pesos que siga. */
const pasoCrudo = maximo / 4;
const magnitud = 10 ** Math.floor(Math.log10(pasoCrudo));
const paso = Math.ceil(pasoCrudo / magnitud) * magnitud;
const techo = paso * 4;

const y = (v: number) => MARGEN.arriba + zona.h - (v / techo) * zona.h;
const altoDe = (v: number) => (v / techo) * zona.h;

const anchoMes = zona.w / 12;
const anchoBarra = Math.floor((anchoMes - 10) / 2);
const xMes = (i: number) => MARGEN.izquierda + i * anchoMes;

const cifra = (v: number) => formatoMXN(v).replace('.00', '');
const lineas = [1, 2, 3].map((n) => n * paso);
---

<figure class="grafica">
  <figcaption class="grafica__titulo">Ingresos y egresos por mes</figcaption>
  <svg
    viewBox={`0 0 ${ANCHO} ${ALTO}`}
    role="img"
    aria-label="Barras de ingresos y egresos de cada mes del ejercicio"
  >
    {/* Rejilla recesiva y etiquetas del eje. */}
    {lineas.map((v) => (
      <>
        <line
          x1={MARGEN.izquierda}
          x2={ANCHO - MARGEN.derecha}
          y1={y(v)}
          y2={y(v)}
          class="grafica__rejilla"
        />
        <text x={MARGEN.izquierda - 6} y={y(v) + 3} text-anchor="end" class="grafica__eje">
          {cifra(v)}
        </text>
      </>
    ))}
    <line
      x1={MARGEN.izquierda}
      x2={ANCHO - MARGEN.derecha}
      y1={y(0)}
      y2={y(0)}
      class="grafica__base"
    />

    {flujo.map((f, i) => (
      <a
        href={anio ? enlaceDe(f.mes) : undefined}
        class="grafica__mes"
        aria-label={anio ? `${MESES[f.mes - 1]}: ingresos ${formatoMXN(f.ingresos)}, egresos ${formatoMXN(f.egresos)}` : undefined}
      >
        {/* Zona de clic de todo el mes, y el resalte del mes elegido. */}
        <rect
          x={xMes(i) + 1}
          y={MARGEN.arriba}
          width={anchoMes - 2}
          height={zona.h + MARGEN.abajo - 4}
          rx="4"
          class:list={['grafica__zona', { 'grafica__zona--elegida': anio && periodoDe(f.mes) === seleccionado }]}
        />
        {f.ingresos > 0 && (
          <rect
            x={xMes(i) + 4}
            y={y(f.ingresos)}
            width={anchoBarra}
            height={altoDe(f.ingresos)}
            rx="3"
            class="grafica__ingreso"
          >
            <title>{`${MESES[f.mes - 1]}: ingresos ${formatoMXN(f.ingresos)}`}</title>
          </rect>
        )}
        {f.egresos > 0 && (
          <rect
            x={xMes(i) + 6 + anchoBarra}
            y={y(f.egresos)}
            width={anchoBarra}
            height={altoDe(f.egresos)}
            rx="3"
            class="grafica__egreso"
          >
            <title>{`${MESES[f.mes - 1]}: egresos ${formatoMXN(f.egresos)}`}</title>
          </rect>
        )}
        <text
          x={xMes(i) + anchoMes / 2}
          y={ALTO - 8}
          text-anchor="middle"
          class="grafica__eje"
        >
          {MESES_CORTOS[f.mes - 1]}
        </text>
      </a>
    ))}
  </svg>
  <div class="grafica__leyenda">
    <span><span class="grafica__muestra grafica__muestra--ingreso"></span> Ingresos</span>
    <span><span class="grafica__muestra grafica__muestra--egreso"></span> Egresos</span>
    {anio && <span>Toca un mes para ver solo ese mes.</span>}
  </div>
  <details class="grafica__cifras">
    <summary>Ver cifras por mes</summary>
    <div class="tabla-envoltura">
      <table class="tabla">
        <thead>
          <tr>
            <th scope="col">Mes</th>
            <th scope="col" class="num">Ingresos</th>
            <th scope="col" class="num">Egresos</th>
            <th scope="col" class="num">Resultado</th>
          </tr>
        </thead>
        <tbody>
          {flujo.map((f) => (
            <tr>
              <td>
                {anio ? <a href={enlaceDe(f.mes)}>{MESES[f.mes - 1]}</a> : MESES[f.mes - 1]}
              </td>
              <td class="num">{formatoMXN(f.ingresos)}</td>
              <td class="num">{formatoMXN(f.egresos)}</td>
              <td class="num">{formatoMXN(f.ingresos - f.egresos)}</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <td>Total</td>
            <td class="num">{formatoMXN(flujo.reduce((s, f) => s + f.ingresos, 0))}</td>
            <td class="num">{formatoMXN(flujo.reduce((s, f) => s + f.egresos, 0))}</td>
            <td class="num">{formatoMXN(flujo.reduce((s, f) => s + f.ingresos - f.egresos, 0))}</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </details>
</figure>
