---
/*
 * Barras agrupadas de ingresos y egresos por mes. SVG dibujado en el servidor,
 * sin JavaScript: el detalle de cada barra sale con el tooltip nativo (title).
 * Paleta validada sobre la superficie oscura: oro para ingresos, azul para
 * egresos, con separación suficiente también para daltonismo.
 */
import type { FlujoMes } from '@lib/datos/movimientos';
import { formatoMXN } from '@lib/dinero';
import { MESES, MESES_CORTOS } from '@lib/fechas';

interface Props {
  flujo: FlujoMes[];
}

const { flujo } = Astro.props;

const ANCHO = 680;
const ALTO = 230;
const MARGEN = { arriba: 12, abajo: 26, izquierda: 56, derecha: 8 };
const zona = {
  w: ANCHO - MARGEN.izquierda - MARGEN.derecha,
  h: ALTO - MARGEN.arriba - MARGEN.abajo,
};

const maximo = Math.max(1, ...flujo.flatMap((f) => [f.ingresos, f.egresos]));
/* Techo redondo del eje: el múltiplo de 5,000 o 10,000 pesos que siga. */
const pasoCrudo = maximo / 4;
const magnitud = 10 ** Math.floor(Math.log10(pasoCrudo));
const paso = Math.ceil(pasoCrudo / magnitud) * magnitud;
const techo = paso * 4;

const y = (v: number) => MARGEN.arriba + zona.h - (v / techo) * zona.h;
const altoDe = (v: number) => (v / techo) * zona.h;

const anchoMes = zona.w / 12;
const anchoBarra = Math.floor((anchoMes - 10) / 2);
const xMes = (i: number) => MARGEN.izquierda + i * anchoMes;

const cifra = (v: number) => formatoMXN(v).replace('.00', '');
const lineas = [1, 2, 3].map((n) => n * paso);
---

<figure class="grafica">
  <figcaption class="grafica__titulo">Ingresos y egresos por mes</figcaption>
  <svg
    viewBox={`0 0 ${ANCHO} ${ALTO}`}
    role="img"
    aria-label="Barras de ingresos y egresos de cada mes del ejercicio"
  >
    {/* Rejilla recesiva y etiquetas del eje. */}
    {lineas.map((v) => (
      <>
        <line
          x1={MARGEN.izquierda}
          x2={ANCHO - MARGEN.derecha}
          y1={y(v)}
          y2={y(v)}
          class="grafica__rejilla"
        />
        <text x={MARGEN.izquierda - 6} y={y(v) + 3} text-anchor="end" class="grafica__eje">
          {cifra(v)}
        </text>
      </>
    ))}
    <line
      x1={MARGEN.izquierda}
      x2={ANCHO - MARGEN.derecha}
      y1={y(0)}
      y2={y(0)}
      class="grafica__base"
    />

    {flujo.map((f, i) => (
      <>
        {f.ingresos > 0 && (
          <rect
            x={xMes(i) + 4}
            y={y(f.ingresos)}
            width={anchoBarra}
            height={altoDe(f.ingresos)}
            rx="3"
            class="grafica__ingreso"
          >
            <title>{`${MESES[f.mes - 1]}: ingresos ${formatoMXN(f.ingresos)}`}</title>
          </rect>
        )}
        {f.egresos > 0 && (
          <rect
            x={xMes(i) + 6 + anchoBarra}
            y={y(f.egresos)}
            width={anchoBarra}
            height={altoDe(f.egresos)}
            rx="3"
            class="grafica__egreso"
          >
            <title>{`${MESES[f.mes - 1]}: egresos ${formatoMXN(f.egresos)}`}</title>
          </rect>
        )}
        <text
          x={xMes(i) + anchoMes / 2}
          y={ALTO - 8}
          text-anchor="middle"
          class="grafica__eje"
        >
          {MESES_CORTOS[f.mes - 1]}
        </text>
      </>
    ))}
  </svg>
  <div class="grafica__leyenda">
    <span><span class="grafica__muestra grafica__muestra--ingreso"></span> Ingresos</span>
    <span><span class="grafica__muestra grafica__muestra--egreso"></span> Egresos</span>
  </div>
</figure>
