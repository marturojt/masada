---
/*
 * Rejilla de hermanos por los doce meses del ejercicio. Es la vista que responde
 * de un vistazo quién está al corriente y de qué mes debe cada quien.
 */
import type { AdeudoMes, EstadoCuenta } from '@lib/datos/capitas';
import { formatoCifra } from '@lib/dinero';
import { MESES_CORTOS, nombrePeriodo } from '@lib/fechas';

import { historiaDelPlan, type PlanConHistoria } from '@lib/capitas-historia';

interface Props {
  anio: number;
  adeudos: AdeudoMes[];
  /** Historia del plan por hermano, para el tooltip de la modalidad. */
  planes?: Map<number, PlanConHistoria>;
  estados: EstadoCuenta[];
}

const { anio, adeudos, estados, planes } = Astro.props;

/* hermano -> mes (1..12) -> cargo del mes */
const porHermano = new Map<number, Map<number, AdeudoMes>>();
for (const a of adeudos) {
  const mes = Number(a.periodo.slice(5, 7));
  const fila = porHermano.get(a.hermano_id) ?? new Map<number, AdeudoMes>();
  fila.set(mes, a);
  porHermano.set(a.hermano_id, fila);
}

const SIMBOLO: Record<string, string> = {
  cubierto: '●',
  parcial: '◐',
  vencido_parcial: '◐',
  vencido: '✕',
  pendiente: '·',
};

const CLASE: Record<string, string> = {
  cubierto: 'celda--cubierto',
  parcial: 'celda--parcial',
  vencido_parcial: 'celda--parcial',
  vencido: 'celda--vencido',
  pendiente: 'celda--pendiente',
};

const ETIQUETA: Record<string, string> = {
  cubierto: 'cubierto',
  parcial: 'parcial',
  vencido_parcial: 'vencido, pago parcial',
  vencido: 'vencido',
  pendiente: 'pendiente',
};

/* Estado para el globo de cada mes, con la insignia de su significado. */
const ESTADO: Record<string, string> = {
  cubierto: 'Cubierto',
  parcial: 'Pago parcial',
  vencido_parcial: 'Vencido, pago parcial',
  vencido: 'Vencido',
  pendiente: 'Por vencer',
};

const INSIGNIA: Record<string, string> = {
  cubierto: 'insignia--ok',
  parcial: 'insignia--pendiente',
  vencido_parcial: 'insignia--alerta',
  vencido: 'insignia--alerta',
  pendiente: 'insignia--pendiente',
};

const meses = Array.from({ length: 12 }, (_, i) => i + 1);

/*
 * Se declara aquí y no en la plantilla: en el cuerpo de un .astro, un
 * new Map<number, AdeudoMes>() se lee como JSX y el compilador se pierde.
 */
const SIN_CARGOS: Map<number, AdeudoMes> = new Map();
---

<!--
  Tocar un mes abre un globo con el cargo, lo pagado y el estado; tocar la
  insignia del plan abre su historia. Son popovers nativos del navegador: sin
  JavaScript propio y sin depender del title, que en el celular no existe.
-->
<div class="tabla-envoltura">
  <table class="tabla tabla--matriz tabla--fija">
    <caption>Cápitas {anio}, mes por mes</caption>
    <thead>
      <tr>
        <th scope="col">Hermano</th>
        {meses.map((m) => <th scope="col" class="celda">{MESES_CORTOS[m - 1]}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        estados.map((e) => {
          const fila = porHermano.get(e.hermano_id) ?? SIN_CARGOS;
          const plan = planes?.get(e.hermano_id);
          /*
            Ajustado es cuando cambió el trato, como una promoción convertida a
            mensual. Un recálculo que deja la misma modalidad (corregir cómo se
            contaron los meses) no es ajuste y no se marca.
          */
          const etiquetaPlan =
            e.modalidad === 'promocion'
              ? 'Promoción'
              : plan?.reemplazo_de && plan.reemplazo_de !== e.modalidad
                ? 'Plan ajustado'
                : null;
          const idPlan = `plan-${e.hermano_id}`;
          return (
            <tr>
              <th scope="row">
                <a href={`/capitas/hermano/${e.hermano_id}`}>{e.nombre_completo}</a>
                {e.estatus === 'baja' && (
                  <>
                    {' '}
                    <span class="insignia">Baja</span>
                  </>
                )}
                {etiquetaPlan && (
                  <>
                    {' '}
                    <button
                      type="button"
                      class="insignia insignia--neutro insignia--boton"
                      popovertarget={idPlan}
                    >
                      {etiquetaPlan}
                    </button>
                    <div id={idPlan} popover="auto" class="globo">
                      <p class="globo__titulo">{e.nombre_completo}</p>
                      <p class="globo__texto">{historiaDelPlan(plan)}</p>
                      <button
                        type="button"
                        class="btn btn--ghost btn--chico"
                        popovertarget={idPlan}
                        popovertargetaction="hide"
                      >
                        Cerrar
                      </button>
                    </div>
                  </>
                )}
              </th>
              {meses.map((m) => {
                const cargo = fila.get(m);
                if (!cargo) {
                  return (
                    <td class="celda celda--vacio">
                      <span aria-hidden="true">–</span>
                      <span class="solo-lectores">sin cargo</span>
                    </td>
                  );
                }
                const mes = nombrePeriodo(cargo.periodo.slice(0, 7));
                const idMes = `mes-${e.hermano_id}-${m}`;
                const resumen =
                  `${mes}: ${ETIQUETA[cargo.estado_pago]}, cargo ${formatoCifra(cargo.monto_esperado_centavos)}` +
                  (cargo.pagado_centavos > 0 ? `, pagado ${formatoCifra(cargo.pagado_centavos)}` : '') +
                  (cargo.condonado_centavos > 0 ? `, exento ${formatoCifra(cargo.condonado_centavos)}` : '');
                return (
                  <td class:list={['celda', CLASE[cargo.estado_pago]]}>
                    <button
                      type="button"
                      class="celda__boton"
                      popovertarget={idMes}
                      aria-label={resumen}
                    >
                      <span aria-hidden="true">{SIMBOLO[cargo.estado_pago]}</span>
                    </button>
                    <div id={idMes} popover="auto" class="globo">
                      <p class="globo__titulo">
                        {e.nombre_completo} · {mes}
                        {cargo.clase === 'promocion' && ', anualidad'}
                      </p>
                      <dl class="globo__datos">
                        <dt>Cargo</dt>
                        <dd>{formatoCifra(cargo.monto_esperado_centavos)}</dd>
                        <dt>Pagado</dt>
                        <dd>{formatoCifra(cargo.pagado_centavos)}</dd>
                        {cargo.condonado_centavos > 0 && (
                          <>
                            <dt>Exento</dt>
                            <dd>{formatoCifra(cargo.condonado_centavos)}</dd>
                          </>
                        )}
                      </dl>
                      <p class="globo__pie">
                        <span class:list={['insignia', INSIGNIA[cargo.estado_pago]]}>
                          {ESTADO[cargo.estado_pago]}
                        </span>
                        <a href={`/capitas/hermano/${e.hermano_id}`}>Ver ficha</a>
                      </p>
                    </div>
                  </td>
                );
              })}
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<p class="apagado letra-menor">
  Toca un mes para ver el detalle. ● cubierto · ◐ parcial · ✕ vencido · · pendiente · – sin cargo ese mes
</p>

<style>
  .tabla--matriz .celda {
    text-align: center;
    padding: 0.1rem;
    font-size: 0.95rem;
    vertical-align: middle;
  }

  /* El símbolo es un botón del tamaño de la celda, cómodo para el dedo. */
  .celda__boton {
    all: unset;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    min-width: 2.1rem;
    min-height: 2.1rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: inherit;
  }

  .celda__boton:hover {
    background: var(--relleno-tenue);
  }

  .celda__boton:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: -2px;
  }

  .celda--cubierto {
    color: var(--md-sys-color-tertiary);
  }

  .celda--parcial {
    color: var(--gold);
  }

  .celda--vencido {
    color: var(--md-sys-color-error);
  }

  .celda--pendiente,
  .celda--vacio {
    color: var(--md-sys-color-outline);
  }

  /* Visible para lectores de pantalla, no en la pantalla. */
  .solo-lectores {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
