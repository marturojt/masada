---
/* Tabla de movimientos del libro de caja, con total al pie. */
import type { MovimientoFila } from '@lib/datos/movimientos';
import { formatoCifra } from '@lib/dinero';
import { NOMBRE_BOLSA } from '@lib/tipos';
import { formatoFechaCorta } from '@lib/fechas';

interface Props {
  movimientos: MovimientoFila[];
  titulo: string;
  /** Folios de recibo por movimiento: agrega la columna Recibo. */
  folios?: Map<number, string>;
  /** Muestra la columna de hermano. */
  conHermano?: boolean;
  /** Muestra el signo del efecto en caja en vez del monto a secas. */
  conSigno?: boolean;
  /** Ofrece adjuntar comprobante a los ingresos que no lo tienen. */
  conAdjuntar?: boolean;
  /** Ajustes acumulados por movimiento: pinta el neto junto al monto. */
  ajustados?: Map<number, number>;
  vacio?: string;
}

const {
  movimientos,
  titulo,
  folios,
  ajustados,
  conAdjuntar = false,
  conHermano = true,
  conSigno = false,
  vacio = 'Sin movimientos.',
} = Astro.props;

/* El total al pie descuenta los ajustes ligados cuando la tabla los conoce. */
const total = movimientos.reduce(
  (suma, m) =>
    suma + (conSigno ? m.efecto_centavos : m.monto_centavos) - (ajustados?.get(m.id) ?? 0),
  0,
);
const hayAjustes = [...(ajustados?.values() ?? [])].some((a) => a > 0);
---

{
  movimientos.length === 0 ? (
    <p class="apagado">{vacio}</p>
  ) : (
    <div class="tabla-envoltura">
      <table class="tabla">
        <caption>{titulo}</caption>
        <thead>
          <tr>
            <th scope="col">Fecha</th>
            <th scope="col">Concepto</th>
            {conHermano && <th scope="col">Hermano</th>}
            <th scope="col">Bolsa</th>
            <th scope="col">Descripción</th>
            <th scope="col" class="num">
              Monto
            </th>
            <th scope="col">Comprobante</th>
            {folios && <th scope="col">Recibo</th>}
          </tr>
        </thead>
        <tbody>
          {movimientos.map((m) => (
            <tr>
              <td>{formatoFechaCorta(m.fecha)}</td>
              <td>
                {m.concepto_nombre}
                {m.es_ajuste && (
                  <>
                    {' '}
                    <span class="insignia">Ajuste</span>
                  </>
                )}
              </td>
              {conHermano && (
                <td>
                  {m.hermano_id ? (
                    <a href={`/hermanos/${m.hermano_id}`}>{m.hermano_nombre}</a>
                  ) : (
                    <span class="apagado">—</span>
                  )}
                </td>
              )}
              <td>{NOMBRE_BOLSA[m.bolsa]}</td>
              <td>{m.descripcion}</td>
              <td class="num">
                {conSigno && m.tipo === 'egreso' ? '−' : ''}
                {formatoCifra(m.monto_centavos)}
                {(ajustados?.get(m.id) ?? 0) > 0 && (
                  <>
                    <br />
                    <span class="insignia insignia--pendiente">
                      neto {formatoCifra(m.monto_centavos - (ajustados?.get(m.id) ?? 0))}
                    </span>
                  </>
                )}
              </td>
              <td>
                {m.archivo_id ? (
                  <a href={`/comprobantes/${m.archivo_id}`} rel="noopener">
                    Ver
                  </a>
                ) : conAdjuntar && m.tipo === 'ingreso' && !m.es_ajuste ? (
                  <a href={`/ingresos/${m.id}/comprobante`}>Adjuntar</a>
                ) : (
                  <span class="apagado">—</span>
                )}
              </td>
              {folios && (
                <td>
                  {folios.get(m.id) ? (
                    <a href={`/recibos/${m.id}`}>{folios.get(m.id)}</a>
                  ) : (
                    <span class="apagado">—</span>
                  )}
                </td>
              )}
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <td colspan={conHermano ? 5 : 4}>Total{hayAjustes && ', neto de ajustes'}</td>
            <td class="num">{formatoCifra(total)}</td>
            <td />
            {folios && <td />}
          </tr>
        </tfoot>
      </table>
    </div>
  )
}
