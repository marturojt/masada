---
/*
 * Campos del alta y de la edición de un hermano. En el alta no se piden las
 * fechas de iniciación ni de afiliación: se derivan de la fecha de ingreso al
 * guardar. En la edición sí aparecen, porque son el dato fino de secretaría.
 */
import Campo from './Campo.astro';
import Formulario from './Formulario.astro';
import ResumenErrores from './ResumenErrores.astro';
import Selector from './Selector.astro';
import type { Cargo } from '@lib/datos/cargos';
import { NOMBRE_MOTIVO_INGRESO, OPCIONES_MOTIVO_INGRESO } from '@lib/esquemas/hermano';
import { NOMBRE_GRADO, type Opcion } from '@lib/tipos';

interface Props {
  csrf: string;
  nonce: string;
  valores: Record<string, string>;
  errores: Record<string, string>;
  cargos: Cargo[];
  anio: number;
  textoBoton: string;
  cancelarA: string;
  /** true en el alta: las fechas de secretaría se derivan, no se piden. */
  alta?: boolean;
}

const {
  csrf, nonce, valores, errores, cargos, anio, textoBoton, cancelarA, alta = false,
} = Astro.props;

const ETIQUETAS: Record<string, string> = {
  nombre_completo: 'Nombre completo',
  grado: 'Grado',
  fecha_ingreso: 'Fecha de ingreso',
  motivo_ingreso: 'Motivo de ingreso',
  fecha_iniciacion: 'Fecha de iniciación',
  fecha_afiliacion: 'Fecha de afiliación',
  correo: 'Correo',
  telefono: 'Teléfono',
  cargo_id: 'Cargo',
  notas: 'Notas',
};

const opcionesGrado: Opcion[] = (['aprendiz', 'companero', 'maestro'] as const).map((g) => ({
  valor: g,
  texto: NOMBRE_GRADO[g],
}));

const opcionesMotivo: Opcion[] = OPCIONES_MOTIVO_INGRESO.map((valor) => ({
  valor,
  texto: NOMBRE_MOTIVO_INGRESO[valor] ?? valor,
}));

const opcionesCargo: Opcion[] = cargos.map((c) => ({
  valor: String(c.id),
  texto: c.nombre,
  grupo: c.es_dignatario ? 'Dignatarios' : 'Oficiales',
}));
---

<ResumenErrores errores={errores} etiquetas={ETIQUETAS} />

<Formulario csrf={csrf} nonce={nonce}>
  <Campo
    nombre="nombre_completo"
    etiqueta={ETIQUETAS.nombre_completo!}
    valor={valores.nombre_completo}
    error={errores.nombre_completo}
    ayuda="Tal como debe aparecer en el cuadro logial del sitio."
    requerido
    autoenfoque
  />

  <Selector
    nombre="grado"
    etiqueta={ETIQUETAS.grado!}
    opciones={opcionesGrado}
    valor={valores.grado}
    error={errores.grado}
    requerido
  />

  <Selector
    nombre="motivo_ingreso"
    etiqueta={ETIQUETAS.motivo_ingreso!}
    opciones={opcionesMotivo}
    valor={valores.motivo_ingreso}
    error={errores.motivo_ingreso}
    requerido
    ayuda="Para un recién iniciado usa Iniciado en la logia. Para quien viene de años atrás y no se sabe su origen, Miembro de años anteriores."
  />

  <Campo
    nombre="fecha_ingreso"
    etiqueta={ETIQUETAS.fecha_ingreso!}
    valor={valores.fecha_ingreso}
    error={errores.fecha_ingreso}
    marcador="AAAA-MM-DD"
    ayuda={`De aquí salen sus cápitas. Para un recién iniciado o un afiliado es el día de su iniciación o afiliación. Para un miembro de años anteriores déjala en blanco y queda el 31 de diciembre de ${anio - 1}. También vale escribirla como 31/08/${anio}.`}
  />

  <Selector
    nombre="cargo_id"
    etiqueta={`${ETIQUETAS.cargo_id} ${anio}`}
    opciones={opcionesCargo}
    valor={valores.cargo_id}
    error={errores.cargo_id}
    vacio="Sin cargo"
    ayuda="Si el cargo ya lo tenía otro hermano, se le traspasa."
  />

  {/* Dato fino de secretaría: en el alta se deriva de la fecha de ingreso.
      De texto y no de fecha porque Safari pinta un campo de fecha vacío como
      si trajera la fecha de hoy, y estos pueden ir en blanco de verdad. */}
  {
    !alta && (
      <>
        <Campo
          nombre="fecha_iniciacion"
          etiqueta={ETIQUETAS.fecha_iniciacion!}
          valor={valores.fecha_iniciacion}
          error={errores.fecha_iniciacion}
          marcador="AAAA-MM-DD"
          ayuda="Dato para la secretaría. En blanco si no se conoce; en un iniciado en la logia que se deje en blanco, se toma su fecha de ingreso."
        />

        <Campo
          nombre="fecha_afiliacion"
          etiqueta={ETIQUETAS.fecha_afiliacion!}
          valor={valores.fecha_afiliacion}
          error={errores.fecha_afiliacion}
          marcador="AAAA-MM-DD"
          ayuda="Dato para la secretaría. En blanco si no se conoce; en un afiliado que se deje en blanco, se toma su fecha de ingreso."
        />
      </>
    )
  }

  <Campo
    nombre="correo"
    etiqueta={ETIQUETAS.correo!}
    tipo="email"
    valor={valores.correo}
    error={errores.correo}
    ayuda="No se publica en el sitio, es solo para la tesorería."
  />

  <Campo
    nombre="telefono"
    etiqueta={ETIQUETAS.telefono!}
    tipo="tel"
    valor={valores.telefono}
    error={errores.telefono}
  />

  <Campo
    nombre="notas"
    etiqueta={ETIQUETAS.notas!}
    valor={valores.notas}
    error={errores.notas}
    largo
  />

  <div class="formulario__acciones">
    <button class="btn btn--primary" type="submit">{textoBoton}</button>
    <a class="btn btn--ghost" href={cancelarA}>Cancelar</a>
  </div>
</Formulario>
