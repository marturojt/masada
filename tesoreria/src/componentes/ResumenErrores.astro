---
/*
 * Resumen de errores arriba del formulario, con enlaces a cada campo.
 * role="alert" para que un lector de pantalla lo anuncie sin JavaScript.
 */
interface Props {
  errores: Record<string, string>;
  /** Etiqueta legible por nombre de campo, para el texto del enlace. */
  etiquetas?: Record<string, string>;
}

const { errores, etiquetas = {} } = Astro.props;

/*
 * Nombres legibles de los campos más comunes, para que el resumen nunca muestre
 * el nombre técnico del campo cuando la página no pasa sus etiquetas.
 */
const COMUNES: Record<string, string> = {
  confirmo: 'Confirmación',
  motivo: 'Motivo',
  fecha: 'Fecha',
  monto: 'Monto',
  descripcion: 'Descripción',
  observaciones: 'Observaciones',
  archivo: 'Archivo',
  comprobante: 'Comprobante',
  bolsa: 'Dónde quedó el dinero',
  mensaje: 'Mensaje',
  banco: 'En el banco',
  efectivo: 'En efectivo',
  tipo: 'Tipo',
  fecha_entrega: 'Fecha de entrega',
  monto_entregado: 'Monto entregado',
  descripcion_pago: 'Descripción del pago',
  motivo_suplencia: 'Motivo de la suplencia',
  hermano_id: 'Hermano',
  concepto_id: 'Concepto',
};
const nombreDe = (campo: string): string => {
  const conocido = etiquetas[campo] ?? COMUNES[campo];
  if (conocido) return conocido;
  const t = campo.replace(/_/g, ' ');
  return t.charAt(0).toUpperCase() + t.slice(1);
};

const general = errores._general;
const porCampo = Object.entries(errores).filter(([campo]) => campo !== '_general');
const hayAlgo = Boolean(general) || porCampo.length > 0;
---

{
  hayAlgo && (
    <div class="aviso aviso--error" role="alert">
      {general && <p style="margin: 0;">{general}</p>}
      {porCampo.length > 0 && (
        <>
          {!general && <p style="margin: 0;">Revisa lo siguiente:</p>}
          <ul>
            {porCampo.map(([campo, mensaje]) => (
              <li>
                <a href={`#campo-${campo}`}>{nombreDe(campo)}</a>: {mensaje}
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  )
}
