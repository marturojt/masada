---
/*
 * Barra superior del panel: botón del menú (solo en el celular), marca y el
 * menú del usuario. Las secciones viven en MenuLateral. Salir es POST, nunca un
 * enlace.
 */
import { NOMBRE_ROL } from '@lib/tipos';
import type { Sesion } from '@lib/sesion';
import Formulario from './Formulario.astro';
import Icono from './Icono.astro';

interface Props {
  sesion: Sesion;
}

const { sesion } = Astro.props;
const { nombre, correo, rol } = sesion.usuario;
---

<header class="barra">
  <div class="barra__fila">
    <button class="barra__boton-menu" type="button" popovertarget="menu">
      <Icono nombre="menu" />
      Menú
    </button>

    <a class="barra__marca" href="/">Masada 324<span class="barra__marca-resto"> · Tesorería</span></a>

    <button
      class="usuario-menu__boton"
      type="button"
      popovertarget="menu-usuario"
      aria-label={`Cuenta de ${nombre}`}
    >
      <span class="usuario-menu__inicial" aria-hidden="true">{nombre.trim().charAt(0)}</span>
      <span class="usuario-menu__nombre">{nombre}</span>
      <Icono nombre="abajo" />
    </button>

    <div id="menu-usuario" class="usuario-menu" popover="auto">
      <div class="usuario-menu__cabeza">
        <p class="usuario-menu__quien">{nombre}</p>
        <p class="usuario-menu__dato">{NOMBRE_ROL[rol]}</p>
        <p class="usuario-menu__dato">{correo}</p>
      </div>
      <a class="usuario-menu__opcion" href="/herramientas#contrasena">
        <Icono nombre="llave" />
        Cambiar mi contraseña
      </a>
      <Formulario accion="/salir" csrf={sesion.csrfToken}>
        <button class="usuario-menu__opcion" type="submit">
          <Icono nombre="salir" />
          Salir
        </button>
      </Formulario>
    </div>
  </div>
</header>
