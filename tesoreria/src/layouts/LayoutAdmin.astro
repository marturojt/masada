---
/*
 * Shell del panel: barra arriba, menú a la izquierda y el contenido a la
 * derecha. Nunca indexable, sin OG, sin RSS, sin analítica.
 */
import '@styles/fuentes.css';
import '@styles/admin.css';
import NavAdmin from '@componentes/NavAdmin.astro';
import MenuLateral from '@componentes/MenuLateral.astro';
import type { Sesion } from '@lib/sesion';

interface Props {
  titulo: string;
  sesion: Sesion;
  /** Ancho angosto para formularios de captura. */
  angosto?: boolean;
}

const { titulo, sesion, angosto = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Tesorería Masada 324</title>
  </head>
  <body>
    <NavAdmin sesion={sesion} />

    <div class="app">
      <MenuLateral sesion={sesion} />

      <div class="app__contenido">
        <slot name="contexto" />
        <main class:list={['panel', angosto && 'panel--angosto']}>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
