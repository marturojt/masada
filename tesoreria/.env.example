# Copiar a .env y ajustar. El archivo .env va en modo 600 y NO se versiona.
# Ningún nombre lleva prefijo PUBLIC_, esas variables viajarían al navegador.

# Conexión a PostgreSQL. En el VPS conviene el socket unix:
#   postgres:///tesoreria?host=/var/run/postgresql
DATABASE_URL=postgres://marturojt@127.0.0.1:5432/masada_tesoreria

# Carpeta donde se guardan los comprobantes. Fuera del webroot, siempre.
COMPROBANTES_DIR=/Users/marturojt/Developer/masada/tesoreria/comprobantes

# Origen exacto que se acepta en los formularios. Sin diagonal final.
TS_ORIGEN=http://127.0.0.1:4322

# local | produccion. En produccion la cookie de sesión exige HTTPS.
TS_ENTORNO=local

# Nombre de la cookie de sesión. En produccion usar __Host-ts_sesion.
TS_COOKIE_NOMBRE=ts_sesion

# Tamaño máximo de subida en bytes. 10 MB.
TS_MAX_SUBIDA_BYTES=10485760

# true solo si hay un proxy inverso de confianza al frente (Apache en el VPS).
TS_CONFIAR_PROXY=false

# Raíz del sitio público, para exportar el cuadro logial.
TS_RUTA_SITIO_PUBLICO=/Users/marturojt/Developer/masada

# Bind del servidor en produccion.
HOST=127.0.0.1
PORT=4322
